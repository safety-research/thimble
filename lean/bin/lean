#!/bin/sh
# thimble's lean kernel as one command. Claude Code puts a plugin's bin/ folder on the Bash tool's PATH, so `lean` runs
# as a bare command, through the session's permission mode like any other. The Python it runs: LEAN_PYTHON, else the
# plugin's own .venv, else python3 (only `lean q` needs pandas).
here=$(cd "$(dirname "$0")/.." && pwd)
[ "$1" = verb ] && { v=$2; shift 2; exec node "$here/verbs/$v/cli.mjs" "$@"; }
# the prompt registry (prompts/node.mjs) and the session's cost and time per feature (telemetry/stats.mjs)
case "$1" in prompts|guide) exec node "$here/prompts/node.mjs" "$@";; stats) shift; exec node "$here/telemetry/stats.mjs" "$@";; esac
py=${LEAN_PYTHON:-}
if [ -z "$py" ] && [ -x "$here/.venv/bin/python" ]; then py="$here/.venv/bin/python"; fi
exec "${py:-python3}" "$here/engine/lean.py" "$@"
