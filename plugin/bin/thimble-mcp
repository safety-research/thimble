#!/bin/sh
''''exec "$(dirname "$0")/thimble-python" "$0" "$@" # '''
"""The thimble MCP shim: the stdio MCP server of the analyst's Claude Code session.

The first two lines make this file both a shell script and a Python program: `sh` runs the `exec` line, which re-runs
the file under backend/.venv's Python through bin/thimble-python; Python reads that line as a string literal.

The shim starts with every Claude Code session that loads the plugin, and gives no instructions in any session.

Before thimble is on in the session (no session marker, `<home>/up/<sid>.active`, app/activate.py), the shim lists one
tool, load_thimble (tools.ENTRY_TOOL), which Claude Code defers and ToolSearch finds by its search hint, and does
nothing else but look whether the marker appeared every RETRY_S (watch_session), for an activation made outside it (the
/thimble skill, a shell). A call of load_thimble, from the model or from the terminal mod's `$.mcp.call`, is answered
here (load_thimble): the session id read once, the session activated (activate.activate, via `tool`, idempotent), main's
tools listed in its place with one notifications/tools/list_changed, Claude Code's tools/list that follows awaited for at
most LIST_WAIT_S, and thimble's guidance as the answer (activate.answer, which marks it sent only when no mod runs here).
Each tools/list the shim answers once thimble is on writes the record `<home>/up/<sid>/listed.json` (contract C4), as
does a new session id (/clear, /resume) or a marker that appears.

Placement (placement, live check LC12): plugin/.mcp.json sets no server `alwaysLoad`, so `claude` starts without
waiting for the shim; load_thimble has no `anthropic/alwaysLoad` (deferred) and each tool of thimble's carries it true
(loaded, and surfaced when it is first listed in the middle of a session). The fallback gives 0.8.0's
form instead: load_thimble's alwaysLoad false and the other tools' absent; the shim takes it when .mcp.json gives the
server `alwaysLoad: true`, so that one switch sets both.

Tools are listed from disk (app.tools.list, schemas from prompts/tools.md), with the view tools' text for the page a
view build makes now (prompts' build target: term-page before the press, html-page after it). A call runs by the
session's transport, read per call (activate.transport, runtime's local.transport): in this process while it is local
(call_local, local.call, the backend loaded on the first call), else posted to the server after the press (call_server):
POST {server}/api/tools/<name> with {args, actor, cwd, session, session_token, tool_use_id}. Calls run concurrently and
report MCP progress every PROGRESS_S, since Claude Code aborts a call that is silent for its idle timeout. The server's
address and token are read per call from $THIMBLE_HOME/server.json; every request proves the shim holds the token, and
an answer is believed only when it proves the server does, as the plugin's hooks do (app/hook_auth.py). After the press
the transport stays the server's: when the server does not answer twice, STOPPED_GAP_S apart, a call answers
PAGE_STOPPED and the shim posts the `page:stopped` notice.

Session: a session thimble starts names itself in THIMBLE_SESSION and proves it with THIMBLE_SESSION_TOKEN, which the
server checks (app/hook_auth.py); it lists its tools from the start and calls the server. Claude Code's background
service can hand one session's environment on to the user's other sessions, so THIMBLE_SESSION without a token is not
believed: the shim then serves the analyst's session (own_session).

Subscription: while the analyst's session runs on the server transport, the shim subscribes to GET {server}/api/events
(server-sent events) with its folder, its session id, its parent's pid, the session's CLAUDE_CONFIG_DIR and the route
its session hears events by: `hook`, or `monitor` where the plugin's hooks are off (app.cc_plugin.route). The
subscription attaches the session to its workspace and is its liveness; it carries no events, which the plugin's
watcher takes from the server. It is renewed when the session id changes, which the shim checks at each keep-alive.

Protocol: the shim serves only the initialize-handshake protocol (2025-11-25 and earlier); a 2026-07-28
`server/discover` probe is refused, and Claude Code falls back to the handshake. fd 1 is pointed at stderr once the MCP
stream has its own copy of it (terminal_stdout), so a library or a child process that writes to stdout cannot corrupt
the protocol.

`thimble-mcp --list` prints the tool list as JSON, without MCP.
"""
import hmac
import inspect
import json
import logging
import os
import sys
import urllib.parse
from pathlib import Path
from typing import Annotated, Any

import anyio
import httpx

HERE = Path(__file__).resolve()
REPO = Path(os.environ.get("THIMBLE_APP_DIR") or HERE.parents[2])  # the tree bin/thimble-python resolved, else ../..
sys.path.insert(0, str(REPO / "backend"))

import mcp.types as mcp_types  # noqa: E402
from mcp.server import NotificationOptions  # noqa: E402
from mcp.server.connection import Connection  # noqa: E402
from mcp.server.mcpserver import Context, MCPServer  # noqa: E402
from mcp.server.mcpserver.tools.base import Tool  # noqa: E402
from mcp.server.runner import serve_connection  # noqa: E402
from mcp.server.stdio import stdio_server  # noqa: E402
from mcp.shared.jsonrpc_dispatcher import JSONRPCDispatcher  # noqa: E402
from pydantic import Field  # noqa: E402

from app import activate, cc_plugin, hook_auth, local, prompts, tools  # noqa: E402  (imports app.config, app.prompts, app.procs and starlette only)

logging.basicConfig(level=logging.WARNING, stream=sys.stderr, format="thimble-mcp %(levelname)s: %(message)s")
log = logging.getLogger("thimble-mcp")

ROLE = tools.ANALYST
# the model cannot run /thimble itself (the skill is the analyst's alone), so the text says who types it
SERVER_DOWN = ("the thimble server is not running. Ask the analyst to type /thimble in this terminal, which starts it "
               "again with the workspace as it was; you cannot run that skill yourself.")
NO_RECORD = ("no thimble server is recorded: {path} is missing or holds no token, so `{name}` was sent nowhere. Ask the "
             "analyst to type /thimble in this terminal, which starts the server; you cannot run that skill yourself.")
# an answer without the server's proof of the token (module note): not thimble's server, or not this install's
UNPROVEN = ("`{name}` was not run: what answers at {base} did not prove it is the thimble server recorded in "
            "server.json. Ask the analyst to type /thimble in this terminal, which restarts it.")
# a call whose connection dropped after it was sent, once a server answers again (call_server)
RESTARTED = ("the thimble server restarted while `{name}` ran, so its answer was lost and the call may or may not have "
             "taken effect. Check (list the cards, or read the document) before you make it again.")
# a call whose connection dropped while the same server runs on
DROPPED = ("the connection to the thimble server dropped while `{name}` ran, so its answer was lost and the call may "
           "or may not have taken effect. Check before you make it again.")
CALL_RETRY_S = 15.0  # how long a refused connection is tried again, and how long a dropped call waits for the server
RETRY_ENV = "THIMBLE_MCP_RETRY_S"
PROGRESS_S = 60.0  # how often a call in flight reports progress (with_progress)
PROGRESS_ENV = "THIMBLE_MCP_PROGRESS_S"
SESSION_ENV = "THIMBLE_SESSION"  # the session this shim serves: `orient`, `writer:<doc>` or `critique:<id>` for a session thimble started (agent_session.py)
TOKEN_ENV = hook_auth.SESSION_TOKEN_ENV  # what proves SESSION_ENV (module note, session)
RETRY_S = 2.0  # between subscriptions, and between looks for the session marker before thimble is on (watch_session)
LIVE_POLL_S = 1.0  # once thimble is on: between looks at the session id and the session's transport (watch_session)
LIST_WAIT_S = 2.0  # how long load_thimble waits for Claude Code's tools/list after its list_changed
STOPPED_GAP_S = 2.0  # between the two looks that find the server down after the press (call_server_or_stopped)
# after the press, a call when the server answers neither look (module note); the shim also posts PAGE_STOPPED_KEY
PAGE_STOPPED = "thimble's page stopped. Ask the analyst to type /thimble browser to start it again."
PAGE_STOPPED_KEY = "page:stopped"
PAGE_STOPPED_NOTICE = "thimble's page stopped. thimble's tools wait for it."
# load_thimble when Claude Code's record of this process names no session
NO_SESSION = ("thimble could not tell which Claude Code session this is, so it did not turn on. Ask the analyst to type "
              "/thimble in this terminal.")
TOOL_USE_META = "claudecode/toolUseId"  # the key of Claude Code's id for a call in the request's `_meta`
CTX_PARAM = "thimble_mcp_context"  # the generated handler's MCP context parameter (_tool), which no tool's schema lists
_JSON_TYPES = {"string": str, "number": float, "integer": int, "boolean": bool, "array": list, "object": dict}


def own_session() -> tuple[str | None, str | None]:
    """(the session this shim serves, the token that proves it), or (None, None) for the analyst's session: a session
    name without a token (module note, session)."""
    name, token = os.environ.get(SESSION_ENV) or None, os.environ.get(TOKEN_ENV) or None
    return (name, token) if name and token else (None, None)


def server_json() -> Path:
    return Path(os.environ.get("THIMBLE_HOME") or (Path.home() / ".thimble")) / "server.json"


def server() -> tuple[str, str] | None:
    """(the server's API base URL, its token) from server.json (`api`, then `port`; never `url`, which in dev mode is
    Vite's); None without the file, a token or an address. Read per call, so a server started after this shim is found."""
    try:
        data = json.loads(server_json().read_text("utf-8"))
    except (OSError, ValueError):
        return None
    token = data.get("token") if isinstance(data, dict) else None
    if not isinstance(token, str) or not token:
        return None
    try:
        if data.get("api"):
            return str(data["api"]).rstrip("/"), token
        if data.get("port"):
            return f"http://127.0.0.1:{int(data['port'])}", token
    except (TypeError, ValueError):
        pass
    return None


def signed(token: str, base: str) -> tuple[dict[str, str], str]:
    """A request's headers proving `token` to the server at `base` for a fresh nonce (good on that port alone, for a few
    minutes, once), and the proof the server's answer must carry."""
    nonce = hook_auth.new_nonce()
    return hook_auth.headers(token, hook_auth.port_of(base), nonce), hook_auth.sign(token, "server", nonce)


def proven(resp: httpx.Response, proof: str) -> bool:
    return hmac.compare_digest(resp.headers.get(hook_auth.PROOF_HEADER) or "", proof)


def cwd() -> str:
    return os.environ.get("THIMBLE_CWD") or os.getcwd()


def _result(content: list[dict[str, Any]], is_error: bool) -> mcp_types.CallToolResult:
    blocks: list[Any] = []
    for b in content:
        if b.get("type") == "image":
            blocks.append(mcp_types.ImageContent(type="image", data=str(b.get("data", "")),
                                                 mime_type=str(b.get("mimeType") or b.get("mime_type") or "image/png")))
        else:
            blocks.append(mcp_types.TextContent(type="text", text=str(b.get("text", ""))))
    if not blocks:
        blocks.append(mcp_types.TextContent(type="text", text=""))
    return mcp_types.CallToolResult(content=blocks, is_error=is_error)


def _error(text: str) -> mcp_types.CallToolResult:
    return _result([{"type": "text", "text": text}], True)


def _env_s(name: str, default: float) -> float:
    """A number of seconds from the environment (tests shorten the clocks below), else `default`."""
    try:
        return max(0.0, float(os.environ.get(name) or default))
    except ValueError:
        return default


def _answer(name: str, resp: httpx.Response, proof: str, base: str) -> mcp_types.CallToolResult:
    """The server's answer to a call, as the tool result the model reads; UNPROVEN, or the status alone for an error of
    the server's own stack, when the answer lacks the server's proof."""
    if not proven(resp, proof):
        if resp.status_code >= 500:
            return _error(f"{name} failed on the thimble server (HTTP {resp.status_code})")
        return _error(UNPROVEN.format(name=name, base=base))
    if resp.status_code >= 400:
        detail = resp.text[:500]
        try:
            detail = str(json.loads(detail).get("detail") or detail)
        except (ValueError, AttributeError):
            pass
        if resp.status_code == 404:
            return _error(f"the thimble server does not know the tool `{name}` ({detail}); it may be older than this "
                          "plugin — say /thimble to restart it")
        return _error(f"{name} failed on the thimble server (HTTP {resp.status_code}): {detail}")
    try:
        payload = resp.json()
    except ValueError as e:
        return _error(f"{name}: the thimble server answered with something that is not JSON ({e})")
    if not isinstance(payload, dict):
        return _error(f"{name}: unexpected answer from the thimble server")
    return _result([b for b in payload.get("content") or [] if isinstance(b, dict)], bool(payload.get("is_error")))


async def _boot(client: httpx.AsyncClient) -> str | None:
    """The `boot` token of the server answering now (new for every start), or None when none answers or names one."""
    found = server()
    if found is None:
        return None
    try:
        resp = await client.get(f"{found[0]}/api/health", timeout=2.0)
        boot = resp.json().get("boot") if resp.status_code == 200 else None
    except (httpx.HTTPError, ValueError, AttributeError):
        return None
    return str(boot) if boot else ("" if resp.status_code == 200 else None)


async def _boot_within(client: httpx.AsyncClient, until: float) -> str | None:
    """_boot, asked every half second until a server answers or the clock reaches `until` (the address read fresh
    each time, since a restart may record another port); None when none answered."""
    while True:
        boot = await _boot(client)
        if boot is not None or anyio.current_time() >= until:
            return boot
        await anyio.sleep(0.5)


async def call_server(name: str, args: dict[str, Any], tool_use_id: str | None = None) -> mcp_types.CallToolResult:
    """POST the call and return the server's answer, with no read timeout.

    A refused connection, a missing server.json or a refused proof (a restart writes a new token) is retried for up
    to CALL_RETRY_S, then SERVER_DOWN, NO_RECORD or UNPROVEN. A call cut off mid-flight is not resent, since it may
    have taken effect: when the server's `boot` token changed the answer is RESTARTED, else DROPPED."""
    session, token = own_session()
    body = {"args": args, "actor": ROLE, "cwd": cwd(), "session": session, "session_token": token,
            "tool_use_id": tool_use_id}
    retry = _env_s(RETRY_ENV, CALL_RETRY_S)
    until = anyio.current_time() + retry
    # trust_env=False: the server is on 127.0.0.1, so a proxy the analyst's environment names (HTTP_PROXY without
    # NO_PROXY) must not carry the call
    async with httpx.AsyncClient(timeout=httpx.Timeout(None, connect=3.0), trust_env=False) as client:
        boot = await _boot(client)
        while True:
            found = server()
            if found is None:
                if anyio.current_time() >= until:
                    return _error(NO_RECORD.format(path=server_json(), name=name))
                await anyio.sleep(0.5)
                continue
            base, token = found
            headers, proof = signed(token, base)
            try:
                resp: httpx.Response | None = await client.post(f"{base}/api/tools/{name}", json=body, headers=headers)
            except (httpx.ConnectError, httpx.ConnectTimeout):
                if anyio.current_time() >= until:
                    return _error(SERVER_DOWN)
                await anyio.sleep(0.5)
                boot = boot or await _boot(client)
                continue
            except httpx.HTTPError:
                resp = None  # the connection dropped after the request was sent
            if resp is not None and resp.status_code == 401 and not proven(resp, proof) \
                    and anyio.current_time() < until:
                await anyio.sleep(0.5)  # refused before it ran, so it is safe to send again
                continue
            if resp is not None and resp.status_code < 500:
                return _answer(name, resp, proof, base)
            after = await _boot_within(client, anyio.current_time() + retry)
            if after is None:
                return _error(SERVER_DOWN)
            if not boot or not after or after != boot:
                return _error(RESTARTED.format(name=name))
            if resp is None:
                return _error(DROPPED.format(name=name))
            return _answer(name, resp, proof, base)


# --------------------------------------------------------------------------- the session's state


class _Live:
    """What the shim knows of its session: whether thimble is on (its tools listed), the session id and transport it
    last saw, the build target its listing was made for, and the event a tools/list sets once thimble is on."""

    def __init__(self) -> None:
        self.on = False
        self.sid: str | None = None
        self.transport = activate.LOCAL
        self.target: str | None = None
        self.listed: anyio.Event | None = None
        self.server: "Shim | None" = None
        self.connection: Connection | None = None
        self.route: str | None = None
        self.subscribed = False
        self.begun = False


LIVE = _Live()


def placement() -> str:
    """`fallback` when plugin/.mcp.json gives the server `alwaysLoad: true` (0.8.0's placement), else `lc12` (module
    note, placement): one switch, in .mcp.json, sets both."""
    try:
        conf = json.loads((HERE.parents[1] / ".mcp.json").read_text("utf-8"))
        always = conf["mcpServers"][tools.SERVER_NAME].get("alwaysLoad")
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        always = None
    return "fallback" if always is True else "lc12"


def tool_meta(entry: bool) -> dict[str, Any] | None:
    """A listed tool's `_meta` by placement() (module note): load_thimble's search hint, and alwaysLoad true on each of
    thimble's tools (absent on load_thimble); with the fallback, alwaysLoad false on load_thimble and none on the
    others."""
    if entry:
        meta: dict[str, Any] = {tools.META_SEARCH_HINT: tools.SEARCH_HINT}
        if placement() == "fallback":
            meta[tools.META_ALWAYS_LOAD] = False
        return meta
    return None if placement() == "fallback" else {tools.META_ALWAYS_LOAD: True}


def workspace() -> str | None:
    """The workspace of the shim's folder, with the data folders the session uses (local.settle_dirs); None when the
    folder is no workspace."""
    try:
        local.settle_dirs()
        return local.workspace(cwd())
    except Exception:  # noqa: BLE001 — a folder that cannot be read is no workspace
        log.debug("the workspace of %s could not be read", cwd(), exc_info=True)
        return None


def transport_now() -> str:
    """This session's transport, read per call (activate.transport): `server` only after the press."""
    c = workspace()
    if not c:
        return activate.LOCAL
    try:
        return activate.transport(c, session_id())
    except Exception:  # noqa: BLE001 — a record that cannot be read is the local transport
        return activate.LOCAL


def target_of(transport: str) -> str:
    """The view build target the listing describes: the terminal page before the press, the browser page after it."""
    return prompts.HTML_PAGE if transport == activate.SERVER else prompts.TERM_PAGE


async def call_local(name: str, args: dict[str, Any], tool_use_id: str | None = None) -> mcp_types.CallToolResult:
    """The local transport: run the call in this process (local.call) and return its answer as call_server would."""
    session, token = own_session()
    try:
        payload = await local.call(name, args, cwd=cwd(), session=session, session_token=token, tool_use_id=tool_use_id)
    except Exception as e:  # noqa: BLE001 — the shim answers every call
        log.exception("%s failed in this process", name)
        return _error(f"{name} failed: {type(e).__name__}: {e}")
    return _result([b for b in payload.get("content") or [] if isinstance(b, dict)], bool(payload.get("is_error")))


async def call_server_or_stopped(name: str, args: dict[str, Any], tool_use_id: str | None = None) -> mcp_types.CallToolResult:
    """The server transport of the analyst's session: call_server, unless the server answers neither of two looks
    STOPPED_GAP_S apart, when the call answers PAGE_STOPPED and the `page:stopped` notice is posted (module note). The
    transport stays the server's."""
    async with httpx.AsyncClient(timeout=httpx.Timeout(5.0, connect=2.0), trust_env=False) as client:
        if not await _reachable(client):
            await anyio.sleep(STOPPED_GAP_S)
            if not await _reachable(client):
                c = workspace()
                if c:
                    try:
                        from app import notices  # noqa: PLC0415

                        notices.post(c, kind="server", text=PAGE_STOPPED_NOTICE, key=PAGE_STOPPED_KEY)
                    except Exception:  # noqa: BLE001 — the call still says so
                        log.warning("the page:stopped notice was not posted", exc_info=True)
                return _error(PAGE_STOPPED)
    return await call_server(name, args, tool_use_id)


async def _reachable(client: httpx.AsyncClient) -> bool:
    """Whether a server answers at the address server.json records, whatever it answers; False without the file or
    when the connection is refused or times out."""
    found = server()
    if found is None:
        return False
    try:
        await client.get(f"{found[0]}/api/health", timeout=2.0)
    except httpx.HTTPError:
        return False
    return True


def call_for(name: str) -> Any:
    """The call function of one call: a session thimble started calls the server; the analyst's session runs it by its
    transport, read now."""
    if own_session()[0]:
        return call_server
    return call_server_or_stopped if transport_now() == activate.SERVER else call_local


def terminal_stdout() -> None:
    """Keep fd 1 for the MCP stream alone. sys.stdout becomes a copy of fd 1 (which stdio_server wraps) and fd 1 itself
    points at stderr, so a child process or a C library writing to stdout cannot corrupt the stream."""
    keep = os.dup(1)
    os.dup2(2, 1)
    sys.stdout = os.fdopen(keep, "w", encoding="utf-8", closefd=True)


async def with_progress(ctx: Any, call: Any) -> mcp_types.CallToolResult:
    """Await the call, reporting MCP progress every PROGRESS_S, since Claude Code aborts a call that sends neither a
    result nor progress for its idle timeout."""
    period = _env_s(PROGRESS_ENV, PROGRESS_S)
    result: list[mcp_types.CallToolResult] = []

    async def beat() -> None:
        n = 0
        while True:
            await anyio.sleep(period)
            n += 1
            try:
                await ctx.report_progress(n, message=f"still running after {round(n * period / 60, 1):g} min")
            except Exception as e:  # noqa: BLE001 — progress is advisory; the call goes on without it
                log.debug("progress not sent: %s", e)
                return

    async with anyio.create_task_group() as tg:
        if ctx is not None and period > 0:
            tg.start_soon(beat)
        result.append(await call)
        tg.cancel_scope.cancel()
    return result[0]


def _tool(entry: dict[str, Any], meta: dict[str, Any] | None = None) -> Tool:
    """An MCPServer tool whose wire schema is the tool's JSON schema. MCPServer validates from a Python signature, so
    one is generated: an optional keyword-only parameter per property plus the tool's argument aliases
    (tools.ARG_ALIASES); the listed schema is then replaced by the one from prompts/tools.md."""
    name, schema = entry["name"], entry["input_schema"]
    props: dict[str, Any] = schema.get("properties") or {}
    params: list[inspect.Parameter] = []
    annotations: dict[str, Any] = {}
    for pname, p in props.items():
        py = _JSON_TYPES.get(str(p.get("type")), Any)
        desc = str(p.get("description") or "")
        ann = Annotated[py | None, Field(description=desc)]  # type: ignore[operator]
        params.append(inspect.Parameter(pname, inspect.Parameter.KEYWORD_ONLY, default=None, annotation=ann))
        annotations[pname] = ann
    for alias, target in tools.ARG_ALIASES.get(name, {}).items():
        if alias in props:
            continue
        py = _JSON_TYPES.get(str((props.get(target) or {}).get("type")), Any)
        ann = Annotated[py | None, Field(description=f"Alias of `{target}`.")]  # type: ignore[operator]
        params.append(inspect.Parameter(alias, inspect.Parameter.KEYWORD_ONLY, default=None, annotation=ann))
        annotations[alias] = ann

    async def fn(**kwargs: Any) -> mcp_types.CallToolResult:
        ctx = kwargs.pop(CTX_PARAM, None)
        if name == tools.ENTRY_TOOL:
            return await load_thimble()
        given = {k: v for k, v in kwargs.items() if v is not None}
        return await with_progress(ctx, call_for(name)(name, given, tool_use_id(ctx)))

    params.append(inspect.Parameter(CTX_PARAM, inspect.Parameter.KEYWORD_ONLY, default=None, annotation=Context))
    fn.__name__ = name
    fn.__signature__ = inspect.Signature(params, return_annotation=mcp_types.CallToolResult)  # type: ignore[attr-defined]
    fn.__annotations__ = {**annotations, CTX_PARAM: Context, "return": mcp_types.CallToolResult}
    tool = Tool.from_function(fn, name=name, description=entry["description"], meta=meta)
    tool.parameters = schema
    return tool


def tool_use_id(ctx: Any) -> str | None:
    """Claude Code's id for the call this context serves, from the request's `_meta` (module note); None when absent."""
    try:
        meta = ctx.request_context.meta if ctx is not None else None
    except ValueError:  # no request: a direct call
        return None
    value = meta.get(TOOL_USE_META) if isinstance(meta, dict) else None
    return value if isinstance(value, str) and value else None


def session_id() -> str | None:
    """The Claude Code session this process serves: Claude Code's record of its parent process, else
    CLAUDE_CODE_SESSION_ID; read fresh, since /clear and /resume give the session a new id."""
    home = Path(os.environ.get("CLAUDE_CONFIG_DIR") or (Path.home() / ".claude"))
    try:
        data = json.loads((home / "sessions" / f"{os.getppid()}.json").read_text("utf-8"))
        sid = data.get("sessionId") if isinstance(data, dict) else None
        if isinstance(sid, str) and sid:
            return sid
    except (OSError, ValueError):
        pass
    return os.environ.get("CLAUDE_CODE_SESSION_ID") or None


def marked(sid: str | None) -> bool:
    """Whether the session marker of `sid` is there (app/activate.py): thimble is on in that session."""
    return activate.active(sid)


# --------------------------------------------------------------------------- the listing


class Shim(MCPServer):
    """The MCP server, which records each tools/list it answers once thimble is on (listed.json, contract C4) and
    answers load_thimble also once it is no longer listed (a push of the terminal mod after the model's own call)."""

    entry: Tool | None = None

    async def list_tools(self) -> list[mcp_types.Tool]:
        got = await super().list_tools()
        if LIVE.on and not own_session()[0]:
            sid = session_id()
            if sid:
                try:
                    activate.write_listed(sid, [t.name for t in got])
                except Exception:  # noqa: BLE001 — the listing stands without its record
                    log.warning("listed.json was not written", exc_info=True)
            if LIVE.listed is not None:
                LIVE.listed.set()
        return got

    async def call_tool(self, name: str, arguments: dict[str, Any], context: Any = None) -> Any:
        if name == tools.ENTRY_TOOL and self._tool_manager.get_tool(name) is None and self.entry is not None:
            if context is None:
                context = Context(mcp_server=self, subscriptions=self._subscriptions)
            return await self.entry.run(arguments, context, convert_result=True)
        return await super().call_tool(name, arguments, context)


def _set_tools(server: MCPServer, entries: list[dict[str, Any]], entry: bool = False) -> None:
    """The tools `server` lists replaced by `entries`, each with its `_meta` (tool_meta)."""
    server._tool_manager._tools = {t.name: t for t in (_tool(e, tool_meta(entry)) for e in entries)}


def entry_entries() -> list[dict[str, Any]]:
    return tools.entry_listing()


def tool_entries(transport: str | None = None) -> list[dict[str, Any]]:
    """The tools this shim lists once thimble is on (module note): its session kind's, with the view tools' text for
    the build target of `transport` (default: the session's now)."""
    with prompts.rendering(prompts.DEFAULT_FLAGS | {target_of(transport or transport_now())}):
        return tools.list(ROLE, session=own_session()[0])


async def go_live(wait: bool = True) -> bool:
    """List main's tools in place of load_thimble with one list_changed, and with `wait` wait at most LIST_WAIT_S for
    Claude Code's tools/list (whose answer writes listed.json). Starts the card watch (local.begin) on the local
    transport. True when the tools/list came in time."""
    server, connection = LIVE.server, LIVE.connection
    if server is None or connection is None:
        return False
    LIVE.transport = await anyio.to_thread.run_sync(transport_now)
    entries = await anyio.to_thread.run_sync(tool_entries, LIVE.transport)
    LIVE.target = target_of(LIVE.transport)
    LIVE.listed = anyio.Event()
    _set_tools(server, entries)
    first = not LIVE.on
    LIVE.on = True
    LIVE.sid = session_id()
    if first and LIVE.transport == activate.LOCAL and not LIVE.begun:
        LIVE.begun = True
        try:  # the card watch from thimble's start, not its first call (local.begin)
            await anyio.to_thread.run_sync(local.begin, cwd())
        except Exception:  # noqa: BLE001 — the tools still serve without it
            log.exception("the card watch did not start")
    await connection.send_tool_list_changed()
    if not wait:
        return False
    with anyio.move_on_after(LIST_WAIT_S):
        await LIVE.listed.wait()
        return True
    return False


async def load_thimble() -> mcp_types.CallToolResult:
    """load_thimble (contract C5): activate the session (via `tool`; idempotent, keeping an earlier activation's `mod`
    and `via`), list main's tools and wait for Claude Code's tools/list (go_live), and answer with thimble's guidance,
    marked sent only without the mod (activate.answer). A refused folder answers the refusal as an error."""
    sid = session_id()
    if not sid:
        return _error(NO_SESSION)
    folder = cwd()
    got = await anyio.to_thread.run_sync(lambda: activate.activate(folder, sid, "tool"))
    if not got.get("ok"):
        return _error(activate.refusal_text(got.get("error") or {}))
    if not LIVE.on:
        await go_live()
    try:
        text = await anyio.to_thread.run_sync(activate.answer, folder, sid)
    except Exception as e:  # noqa: BLE001 — the shim answers every call
        log.exception("load_thimble's guidance was not rendered")
        return _error(f"load_thimble: thimble is on, but its guidance could not be rendered: {type(e).__name__}: {e}")
    return _result([{"type": "text", "text": text}], False)


# --------------------------------------------------------------------------- watching the session


async def subscription(route: str) -> None:
    """Hold the subscription for as long as the session lives on the server transport (module note). Never raises: a
    failure, a missing server.json or an answer without the server's proof waits RETRY_S and subscribes again; a new
    session id (checked at each keep-alive) resubscribes at once."""
    while True:
        sid = session_id()
        moved = False  # the session id changed under a live subscription: renew it without waiting
        query = urllib.parse.urlencode({**{k: v for k, v in (("cwd", cwd()), ("session", sid), ("pid", os.getppid()),
                                                             ("delivery", route)) if v},
                                        "config_dir": os.environ.get("CLAUDE_CONFIG_DIR", "")})
        try:
            found = server()
            if found is None:
                raise ConnectionError(f"no token in {server_json()}")
            headers, proof = signed(found[1], found[0])
            async with httpx.AsyncClient(timeout=httpx.Timeout(None, connect=3.0), trust_env=False) as client:
                async with client.stream("GET", f"{found[0]}/api/events?{query}", headers=headers) as resp:
                    if resp.status_code != 200 or not proven(resp, proof):
                        await resp.aread()
                        raise ConnectionError(f"HTTP {resp.status_code}" + ("" if proven(resp, proof) else ", unproven"))
                    async for line in resp.aiter_lines():
                        if line.startswith(":") and session_id() != sid:  # the server's keep-alive
                            moved = True
                            break
        except (httpx.HTTPError, ConnectionError, OSError) as e:
            log.debug("subscription: %s", e)
        except Exception:  # noqa: BLE001 — the subscription never takes the tools down with it
            log.exception("subscription failed")
        if not moved:
            await anyio.sleep(RETRY_S)


async def watch_session(tg: Any) -> None:
    """Once Claude Code finished the handshake: before thimble is on, look for the session marker every RETRY_S (an
    activation made outside the shim) and go live when it appears; once on, every LIVE_POLL_S, write listed.json for a
    new session id, and when the transport turns to the server's (the press), list the tools again for the browser's
    page and subscribe (module note)."""
    connection = LIVE.connection
    if connection is None:
        return
    await connection.initialized.wait()
    while not LIVE.on:
        if await anyio.to_thread.run_sync(lambda: marked(session_id())):
            await go_live()
            break
        await anyio.sleep(RETRY_S)
    while True:
        await anyio.sleep(LIVE_POLL_S)
        sid = session_id()
        if sid and sid != LIVE.sid:
            LIVE.sid = sid
            names = list(LIVE.server._tool_manager._tools) if LIVE.server is not None else []
            await anyio.to_thread.run_sync(activate.write_listed, sid, names)
        now = await anyio.to_thread.run_sync(transport_now)
        if now != LIVE.transport:
            LIVE.transport = now
            if target_of(now) != LIVE.target:
                await go_live(wait=False)
        if now == activate.SERVER and LIVE.route and not LIVE.subscribed:
            LIVE.subscribed = True
            tg.start_soon(subscription, LIVE.route)


# --------------------------------------------------------------------------- serving


async def serve(server: Shim) -> None:
    """MCPServer.run_stdio_async with the session watch beside the MCP session (watch_session), and in a session
    thimble started from the start, its tools listed."""
    low = server._lowlevel_server
    # the parent is the `claude` process; a session thimble starts itself hears no browser events (its main does)
    LIVE.route = None if own_session()[0] else cc_plugin.route(cwd(), HERE.parents[1])
    options = low.create_initialization_options(NotificationOptions(tools_changed=True))
    try:
        async with stdio_server() as (read_stream, write_stream):
            async with anyio.create_task_group() as tg:
                # not low.run, which also serves 2026-07-28 (module note, Protocol); serve_loop's own dispatcher and
                # connection, built here so the watch can tell Claude Code the list changed
                dispatcher = JSONRPCDispatcher(read_stream, write_stream, inline_methods=frozenset({"initialize"}))
                connection = Connection.for_loop(dispatcher)
                LIVE.server, LIVE.connection = server, connection
                if not own_session()[0]:
                    tg.start_soon(watch_session, tg)
                async with low.lifespan(low) as lifespan_context:
                    await serve_connection(low, dispatcher, connection=connection, lifespan_state=lifespan_context,
                                           init_options=options)
                tg.cancel_scope.cancel()
    finally:
        if LIVE.begun:
            with anyio.CancelScope(shield=True):
                await local.close()


def build_server() -> Shim:
    """The MCP server, with no instructions: in a session thimble started, its tools; in the analyst's session,
    main's tools when the session is active already (a restart of the shim), else load_thimble alone (module
    note)."""
    local.PLUGIN_ROOT = HERE.parents[1]  # this copy, whose bin/thimble-run the tools' commands name (cardrun.command)
    shim = Shim(tools.SERVER_NAME, instructions=None, tools=[])
    shim.entry = _tool(entry_entries()[0], tool_meta(True))
    if own_session()[0]:
        _set_tools(shim, tool_entries(activate.SERVER))
        LIVE.on = True
    elif marked(session_id()):
        LIVE.transport = transport_now()
        LIVE.target = target_of(LIVE.transport)
        _set_tools(shim, tool_entries(LIVE.transport))
        LIVE.on, LIVE.sid = True, session_id()
    else:
        shim._tool_manager._tools = {tools.ENTRY_TOOL: shim.entry}
    return shim


def listing() -> list[dict[str, Any]]:
    """`--list`: the tools build_server lists now, with each one's `_meta`."""
    shim = build_server()
    return [{"name": t.name, "description": t.description, "input_schema": t.parameters, "_meta": t.meta}
            for t in shim._tool_manager.list_tools()]


if __name__ == "__main__":
    if "--list" in sys.argv[1:]:  # a debugging aid: the tool list as JSON, no server involved
        json.dump(listing(), sys.stdout, indent=1)
        sys.stdout.write("\n")
        sys.exit(0)
    terminal_stdout()
    anyio.run(serve, build_server())
