#!/bin/sh
''''exec "$(dirname "$0")/thimble-python" "$0" "$@" # '''
"""The thimble MCP shim: the stdio MCP server of the analyst's Claude Code session, and its subscription.

The first two lines make this file both a shell script and a Python program: `sh` runs the `exec` line, which re-runs
the file under backend/.venv's Python through bin/thimble-python; Python reads that line as a string literal.

Tools are listed from disk (app.tools.list, schemas from prompts/tools.md), so the list is the same whether the server
is up or down. In the analyst's session in a folder that is no workspace yet (in_workspace), outside terminal mode, the
shim lists one deferred tool, load_thimble (0.9.0; a call turns thimble on in the folder and answers its guide), and
sends no instructions, so a session that never opens thimble carries only that tool's name; it looks every RETRY_S
whether the folder has become one (/thimble or load_thimble registers it), then lists the tools and tells Claude Code
once that the list changed (notifications/tools/list_changed; watch_workspace). Each listing is recorded for the session
in <home>/up/<sid>/listed.json (app/activate.py write_listed). A call is POST {server}/api/tools/<name> with
{args, actor, cwd, session, session_token, tool_use_id}; calls run concurrently and report MCP progress every
PROGRESS_S, since Claude Code aborts a call that is silent for its idle timeout. The server's address and token are read
per call from $THIMBLE_HOME/server.json. Every request to a tool route or the subscription proves the shim holds the
token, and an answer is believed only when it proves the server does, as the plugin's hooks do (app/hook_auth.py).
Without server.json or a token the shim reaches no port: a call reports that no server is recorded, and the subscription
waits.

Session: a session thimble starts names itself in THIMBLE_SESSION and proves it with THIMBLE_SESSION_TOKEN, which the
server checks (app/hook_auth.py). Claude Code's background service can hand one session's environment on to the user's
other sessions, so THIMBLE_SESSION without a token is not believed: the shim then serves the analyst's session
(own_session).

Subscription: in the analyst's session, once its folder is a workspace (in_workspace), the shim subscribes to GET
{server}/api/events (server-sent events) with its folder, its session id, its parent's pid, the session's
CLAUDE_CONFIG_DIR and the route its session hears events by: `hook`, or `monitor` where the plugin's hooks are off
(app.cc_plugin.route). The subscription attaches the session to its workspace and is its liveness; it carries no events,
which the plugin's watcher takes from the server. It is renewed when the session id changes (/clear, /resume), which the
shim checks at each keep-alive.

Protocol: the shim serves only the initialize-handshake protocol (2025-11-25 and earlier); a 2026-07-28
`server/discover` probe is refused, and Claude Code falls back to the handshake.

Terminal mode (app/local.py): when the launcher started the session in terminal mode (THIMBLE_MODE, launch_mode.ENV) and
the workspace of the shim's folder records it (`mode` in trusted/launch.json, read once at start), no server runs. A
plain `claude` session in a folder whose last launch was in terminal mode is in browser mode, since /thimble opens the
folder in browser mode. A call runs `tools.call` in this process (call_local, local.call), the backend loaded on the
first call; the card watch starts with the shim (local.begin), so a card `thimble-run` writes before the session's first
call is checked too; the jobs a call leaves running (a prompt label's run, the card check of a card `thimble-run` wrote)
run on this process's loop and end with it; there is no subscription; and fd 1 is pointed at stderr once the MCP stream
has its own copy of it (terminal_stdout), so a library or a child process that writes to stdout cannot corrupt the
protocol. A folder of no workspace stays in browser mode, whose calls reach no server here, so a process that lost its
environment does nothing.

`thimble-mcp --list` prints the tool list as JSON and `thimble-mcp --instructions` the instructions, without MCP.
"""
import hmac
import inspect
import json
import logging
import os
import sys
import urllib.parse
from pathlib import Path
from typing import Annotated, Any

import anyio
import httpx

HERE = Path(__file__).resolve()
REPO = Path(os.environ.get("THIMBLE_APP_DIR") or HERE.parents[2])  # the tree bin/thimble-python resolved, else ../..
sys.path.insert(0, str(REPO / "backend"))

import mcp.types as mcp_types  # noqa: E402
from mcp.server import NotificationOptions  # noqa: E402
from mcp.server.connection import Connection  # noqa: E402
from mcp.server.mcpserver import Context, MCPServer  # noqa: E402
from mcp.server.mcpserver.tools.base import Tool  # noqa: E402
from mcp.server.runner import serve_connection  # noqa: E402
from mcp.server.stdio import stdio_server  # noqa: E402
from mcp.shared.jsonrpc_dispatcher import JSONRPCDispatcher  # noqa: E402
from pydantic import Field  # noqa: E402

from app import activate, cc_plugin, hook_auth, launch_mode, local, subagent_files, tools  # noqa: E402  (imports app.config, app.prompts, app.procs and starlette only)

logging.basicConfig(level=logging.WARNING, stream=sys.stderr, format="thimble-mcp %(levelname)s: %(message)s")
log = logging.getLogger("thimble-mcp")

ROLE = tools.ANALYST
# the model cannot run /thimble itself (the skill is the analyst's alone), so the text says who types it
SERVER_DOWN = ("the thimble server is not running. Ask the analyst to type /thimble in this terminal, which starts it "
               "again with the workspace as it was; you cannot run that skill yourself.")
NO_RECORD = ("no thimble server is recorded: {path} is missing or holds no token, so `{name}` was sent nowhere. Ask the "
             "analyst to type /thimble in this terminal, which starts the server; you cannot run that skill yourself.")
# an answer without the server's proof of the token (module note): not thimble's server, or not this install's
UNPROVEN = ("`{name}` was not run: what answers at {base} did not prove it is the thimble server recorded in "
            "server.json. Ask the analyst to type /thimble in this terminal, which restarts it.")
# a call whose connection dropped after it was sent, once a server answers again (call_server)
RESTARTED = ("the thimble server restarted while `{name}` ran, so its answer was lost and the call may or may not have "
             "taken effect. Check (list the cards, or read the document) before you make it again.")
# a call whose connection dropped while the same server runs on
DROPPED = ("the connection to the thimble server dropped while `{name}` ran, so its answer was lost and the call may "
           "or may not have taken effect. Check before you make it again.")
CALL_RETRY_S = 15.0  # how long a refused connection is tried again, and how long a dropped call waits for the server
RETRY_ENV = "THIMBLE_MCP_RETRY_S"
PROGRESS_S = 60.0  # how often a call in flight reports progress (with_progress)
PROGRESS_ENV = "THIMBLE_MCP_PROGRESS_S"
SESSION_ENV = "THIMBLE_SESSION"  # the session this shim serves: `orient`, `writer:<doc>` or `critique:<id>` for a session thimble started (agent_session.py)
TOKEN_ENV = hook_auth.SESSION_TOKEN_ENV  # what proves SESSION_ENV (module note, session)
RETRY_S = 2.0  # between subscriptions, and between looks whether the folder is a workspace yet (in_workspace)
TOOL_USE_META = "claudecode/toolUseId"  # the key of Claude Code's id for a call in the request's `_meta`
CTX_PARAM = "thimble_mcp_context"  # the generated handler's MCP context parameter (_tool), which no tool's schema lists
_JSON_TYPES = {"string": str, "number": float, "integer": int, "boolean": bool, "array": list, "object": dict}


def own_session() -> tuple[str | None, str | None]:
    """(the session this shim serves, the token that proves it), or (None, None) for the analyst's session: a session
    name without a token (module note, session)."""
    name, token = os.environ.get(SESSION_ENV) or None, os.environ.get(TOKEN_ENV) or None
    return (name, token) if name and token else (None, None)


def server_json() -> Path:
    return Path(os.environ.get("THIMBLE_HOME") or (Path.home() / ".thimble")) / "server.json"


def server() -> tuple[str, str] | None:
    """(the server's API base URL, its token) from server.json (`api`, then `port`; never `url`, which in dev mode is
    Vite's); None without the file, a token or an address. Read per call, so a server started after this shim is found."""
    try:
        data = json.loads(server_json().read_text("utf-8"))
    except (OSError, ValueError):
        return None
    token = data.get("token") if isinstance(data, dict) else None
    if not isinstance(token, str) or not token:
        return None
    try:
        if data.get("api"):
            return str(data["api"]).rstrip("/"), token
        if data.get("port"):
            return f"http://127.0.0.1:{int(data['port'])}", token
    except (TypeError, ValueError):
        pass
    return None


def signed(token: str, base: str) -> tuple[dict[str, str], str]:
    """A request's headers proving `token` to the server at `base` for a fresh nonce (good on that port alone, for a few
    minutes, once), and the proof the server's answer must carry."""
    nonce = hook_auth.new_nonce()
    return hook_auth.headers(token, hook_auth.port_of(base), nonce), hook_auth.sign(token, "server", nonce)


def proven(resp: httpx.Response, proof: str) -> bool:
    return hmac.compare_digest(resp.headers.get(hook_auth.PROOF_HEADER) or "", proof)


def cwd() -> str:
    return os.environ.get("THIMBLE_CWD") or os.getcwd()


def in_workspace() -> bool:
    """Whether the shim's folder is a thimble workspace (a corpus folder the server would name): /thimble registers it.
    The data folder is read again each time (local.settle_dirs), since the server.json that names it may come later."""
    try:
        local.settle_dirs()
        return subagent_files.workspace_folder(cwd()) is not None
    except Exception:  # noqa: BLE001 — a folder that cannot be read is none
        log.debug("whether %s is a workspace could not be read", cwd(), exc_info=True)
        return False


def _result(content: list[dict[str, Any]], is_error: bool) -> mcp_types.CallToolResult:
    blocks: list[Any] = []
    for b in content:
        if b.get("type") == "image":
            blocks.append(mcp_types.ImageContent(type="image", data=str(b.get("data", "")),
                                                 mime_type=str(b.get("mimeType") or b.get("mime_type") or "image/png")))
        else:
            blocks.append(mcp_types.TextContent(type="text", text=str(b.get("text", ""))))
    if not blocks:
        blocks.append(mcp_types.TextContent(type="text", text=""))
    return mcp_types.CallToolResult(content=blocks, is_error=is_error)


def _error(text: str) -> mcp_types.CallToolResult:
    return _result([{"type": "text", "text": text}], True)


def _env_s(name: str, default: float) -> float:
    """A number of seconds from the environment (tests shorten the clocks below), else `default`."""
    try:
        return max(0.0, float(os.environ.get(name) or default))
    except ValueError:
        return default


def _answer(name: str, resp: httpx.Response, proof: str, base: str) -> mcp_types.CallToolResult:
    """The server's answer to a call, as the tool result the model reads; UNPROVEN, or the status alone for an error of
    the server's own stack, when the answer lacks the server's proof."""
    if not proven(resp, proof):
        if resp.status_code >= 500:
            return _error(f"{name} failed on the thimble server (HTTP {resp.status_code})")
        return _error(UNPROVEN.format(name=name, base=base))
    if resp.status_code >= 400:
        detail = resp.text[:500]
        try:
            detail = str(json.loads(detail).get("detail") or detail)
        except (ValueError, AttributeError):
            pass
        if resp.status_code == 404:
            return _error(f"the thimble server does not know the tool `{name}` ({detail}); it may be older than this "
                          "plugin — say /thimble to restart it")
        return _error(f"{name} failed on the thimble server (HTTP {resp.status_code}): {detail}")
    try:
        payload = resp.json()
    except ValueError as e:
        return _error(f"{name}: the thimble server answered with something that is not JSON ({e})")
    if not isinstance(payload, dict):
        return _error(f"{name}: unexpected answer from the thimble server")
    return _result([b for b in payload.get("content") or [] if isinstance(b, dict)], bool(payload.get("is_error")))


async def _boot(client: httpx.AsyncClient) -> str | None:
    """The `boot` token of the server answering now (new for every start), or None when none answers or names one."""
    found = server()
    if found is None:
        return None
    try:
        resp = await client.get(f"{found[0]}/api/health", timeout=2.0)
        boot = resp.json().get("boot") if resp.status_code == 200 else None
    except (httpx.HTTPError, ValueError, AttributeError):
        return None
    return str(boot) if boot else ("" if resp.status_code == 200 else None)


async def _boot_within(client: httpx.AsyncClient, until: float) -> str | None:
    """_boot, asked every half second until a server answers or the clock reaches `until` (the address read fresh
    each time, since a restart may record another port); None when none answered."""
    while True:
        boot = await _boot(client)
        if boot is not None or anyio.current_time() >= until:
            return boot
        await anyio.sleep(0.5)


async def call_server(name: str, args: dict[str, Any], tool_use_id: str | None = None) -> mcp_types.CallToolResult:
    """POST the call and return the server's answer, with no read timeout.

    A refused connection, a missing server.json or a refused proof (a restart writes a new token) is retried for up
    to CALL_RETRY_S, then SERVER_DOWN, NO_RECORD or UNPROVEN. A call cut off mid-flight is not resent, since it may
    have taken effect: when the server's `boot` token changed the answer is RESTARTED, else DROPPED."""
    session, token = own_session()
    body = {"args": args, "actor": ROLE, "cwd": cwd(), "session": session, "session_token": token,
            "tool_use_id": tool_use_id}
    retry = _env_s(RETRY_ENV, CALL_RETRY_S)
    until = anyio.current_time() + retry
    # trust_env=False: the server is on 127.0.0.1, so a proxy the analyst's environment names (HTTP_PROXY without
    # NO_PROXY) must not carry the call
    async with httpx.AsyncClient(timeout=httpx.Timeout(None, connect=3.0), trust_env=False) as client:
        boot = await _boot(client)
        while True:
            found = server()
            if found is None:
                if anyio.current_time() >= until:
                    return _error(NO_RECORD.format(path=server_json(), name=name))
                await anyio.sleep(0.5)
                continue
            base, token = found
            headers, proof = signed(token, base)
            try:
                resp: httpx.Response | None = await client.post(f"{base}/api/tools/{name}", json=body, headers=headers)
            except (httpx.ConnectError, httpx.ConnectTimeout):
                if anyio.current_time() >= until:
                    return _error(SERVER_DOWN)
                await anyio.sleep(0.5)
                boot = boot or await _boot(client)
                continue
            except httpx.HTTPError:
                resp = None  # the connection dropped after the request was sent
            if resp is not None and resp.status_code == 401 and not proven(resp, proof) \
                    and anyio.current_time() < until:
                await anyio.sleep(0.5)  # refused before it ran, so it is safe to send again
                continue
            if resp is not None and resp.status_code < 500:
                return _answer(name, resp, proof, base)
            after = await _boot_within(client, anyio.current_time() + retry)
            if after is None:
                return _error(SERVER_DOWN)
            if not boot or not after or after != boot:
                return _error(RESTARTED.format(name=name))
            if resp is None:
                return _error(DROPPED.format(name=name))
            return _answer(name, resp, proof, base)


_TERMINAL: list[bool] = []  # the session's mode, read once (terminal)


def terminal() -> bool:
    """Whether this shim serves a terminal-mode session (module note): the launcher started it so (THIMBLE_MODE), and
    the workspace's launch.json says so, read once."""
    if not _TERMINAL:
        if os.environ.get(launch_mode.ENV) != launch_mode.TERMINAL:
            _TERMINAL.append(False)
        else:
            local.settle_dirs()
            local.PLUGIN_ROOT = HERE.parents[1]  # this copy, whose bin/thimble-run the launcher's allow rule names
            c = local.workspace(cwd())
            _TERMINAL.append(bool(c) and local.terminal(c))
    return _TERMINAL[0]


async def call_local(name: str, args: dict[str, Any], tool_use_id: str | None = None) -> mcp_types.CallToolResult:
    """Terminal mode: run the call in this process (local.call) and return its answer as call_server would."""
    session, token = own_session()
    try:
        payload = await local.call(name, args, cwd=cwd(), session=session, session_token=token, tool_use_id=tool_use_id)
    except Exception as e:  # noqa: BLE001 — the shim answers every call
        log.exception("%s failed in terminal mode", name)
        return _error(f"{name} failed: {type(e).__name__}: {e}")
    return _result([b for b in payload.get("content") or [] if isinstance(b, dict)], bool(payload.get("is_error")))


def terminal_stdout() -> None:
    """Terminal mode: keep fd 1 for the MCP stream alone. sys.stdout becomes a copy of fd 1 (which stdio_server wraps)
    and fd 1 itself points at stderr, so a child process or a C library writing to stdout cannot corrupt the stream."""
    keep = os.dup(1)
    os.dup2(2, 1)
    sys.stdout = os.fdopen(keep, "w", encoding="utf-8", closefd=True)


async def with_progress(ctx: Any, call: Any) -> mcp_types.CallToolResult:
    """Await the call, reporting MCP progress every PROGRESS_S, since Claude Code aborts a call that sends neither a
    result nor progress for its idle timeout."""
    period = _env_s(PROGRESS_ENV, PROGRESS_S)
    result: list[mcp_types.CallToolResult] = []

    async def beat() -> None:
        n = 0
        while True:
            await anyio.sleep(period)
            n += 1
            try:
                await ctx.report_progress(n, message=f"still running after {round(n * period / 60, 1):g} min")
            except Exception as e:  # noqa: BLE001 — progress is advisory; the call goes on without it
                log.debug("progress not sent: %s", e)
                return

    async with anyio.create_task_group() as tg:
        if ctx is not None and period > 0:
            tg.start_soon(beat)
        result.append(await call)
        tg.cancel_scope.cancel()
    return result[0]


def _tool(entry: dict[str, Any]) -> Tool:
    """An MCPServer tool whose wire schema is the tool's JSON schema. MCPServer validates from a Python signature, so
    one is generated: an optional keyword-only parameter per property plus the tool's argument aliases
    (tools.ARG_ALIASES); the listed schema is then replaced by the one from prompts/tools.md."""
    name, schema = entry["name"], entry["input_schema"]
    props: dict[str, Any] = schema.get("properties") or {}
    params: list[inspect.Parameter] = []
    annotations: dict[str, Any] = {}
    for pname, p in props.items():
        py = _JSON_TYPES.get(str(p.get("type")), Any)
        desc = str(p.get("description") or "")
        ann = Annotated[py | None, Field(description=desc)]  # type: ignore[operator]
        params.append(inspect.Parameter(pname, inspect.Parameter.KEYWORD_ONLY, default=None, annotation=ann))
        annotations[pname] = ann
    for alias, target in tools.ARG_ALIASES.get(name, {}).items():
        if alias in props:
            continue
        py = _JSON_TYPES.get(str((props.get(target) or {}).get("type")), Any)
        ann = Annotated[py | None, Field(description=f"Alias of `{target}`.")]  # type: ignore[operator]
        params.append(inspect.Parameter(alias, inspect.Parameter.KEYWORD_ONLY, default=None, annotation=ann))
        annotations[alias] = ann

    async def fn(**kwargs: Any) -> mcp_types.CallToolResult:
        ctx = kwargs.pop(CTX_PARAM, None)
        given = {k: v for k, v in kwargs.items() if v is not None}
        call = (call_local if terminal() else call_server)(name, given, tool_use_id(ctx))
        return await with_progress(ctx, call)

    params.append(inspect.Parameter(CTX_PARAM, inspect.Parameter.KEYWORD_ONLY, default=None, annotation=Context))
    fn.__name__ = name
    fn.__signature__ = inspect.Signature(params, return_annotation=mcp_types.CallToolResult)  # type: ignore[attr-defined]
    fn.__annotations__ = {**annotations, CTX_PARAM: Context, "return": mcp_types.CallToolResult}
    tool = Tool.from_function(fn, name=name, description=entry["description"])
    tool.parameters = schema
    return tool


def tool_use_id(ctx: Any) -> str | None:
    """Claude Code's id for the call this context serves, from the request's `_meta` (module note); None when absent."""
    try:
        meta = ctx.request_context.meta if ctx is not None else None
    except ValueError:  # no request: a direct call
        return None
    value = meta.get(TOOL_USE_META) if isinstance(meta, dict) else None
    return value if isinstance(value, str) and value else None


def instructions() -> str:
    """The MCP server instructions: the `## instructions` section of prompts/tools.md, read from disk."""
    return tools.instructions()


def session_id() -> str | None:
    """The Claude Code session this process serves (module note)."""
    home = Path(os.environ.get("CLAUDE_CONFIG_DIR") or (Path.home() / ".claude"))
    try:
        data = json.loads((home / "sessions" / f"{os.getppid()}.json").read_text("utf-8"))
        sid = data.get("sessionId") if isinstance(data, dict) else None
        if isinstance(sid, str) and sid:
            return sid
    except (OSError, ValueError):
        pass
    return os.environ.get("CLAUDE_CODE_SESSION_ID") or None


async def subscription(route: str) -> None:
    """Hold the subscription for as long as the session lives (module note). Never raises: a folder that is no
    workspace yet waits RETRY_S with no request, and looks again; a failure, a missing server.json or an answer without
    the server's proof waits RETRY_S and subscribes again; a new session id (checked at each keep-alive) resubscribes at
    once."""
    while True:
        if not in_workspace():
            await anyio.sleep(RETRY_S)
            continue
        sid = session_id()
        moved = False  # the session id changed under a live subscription: renew it without waiting
        query = urllib.parse.urlencode({**{k: v for k, v in (("cwd", cwd()), ("session", sid), ("pid", os.getppid()),
                                                             ("delivery", route)) if v},
                                        "config_dir": os.environ.get("CLAUDE_CONFIG_DIR", "")})
        try:
            found = server()
            if found is None:
                raise ConnectionError(f"no token in {server_json()}")
            headers, proof = signed(found[1], found[0])
            async with httpx.AsyncClient(timeout=httpx.Timeout(None, connect=3.0), trust_env=False) as client:
                async with client.stream("GET", f"{found[0]}/api/events?{query}", headers=headers) as resp:
                    if resp.status_code != 200 or not proven(resp, proof):
                        await resp.aread()
                        raise ConnectionError(f"HTTP {resp.status_code}" + ("" if proven(resp, proof) else ", unproven"))
                    async for line in resp.aiter_lines():
                        if line.startswith(":") and session_id() != sid:  # the server's keep-alive
                            moved = True
                            break
        except (httpx.HTTPError, ConnectionError, OSError) as e:
            log.debug("subscription: %s", e)
        except Exception:  # noqa: BLE001 — the subscription never takes the tools down with it
            log.exception("subscription failed")
        if not moved:
            await anyio.sleep(RETRY_S)


def _set_tools(server: MCPServer, entries: list[dict[str, Any]]) -> None:
    """The tools `server` lists replaced by `entries`, recorded for this session (listed.json, C4)."""
    server._tool_manager._tools = {t.name: t for t in (_tool(e) for e in entries)}
    activate.write_listed(session_id() or "", [e["name"] for e in entries])


def _load_tool() -> Tool:
    """load_thimble (0.9.0, C5), the one tool listed while the folder is no workspace (deferred: no `_meta`): a call
    turns thimble on here (activate.tool_load, in this process) and answers its guide; watch_workspace lists the tools
    once the folder is a workspace. SCAFFOLD STUB of the core lane's: the guide is 0.8.0's main prompt."""
    entry = activate.LOAD_TOOL

    async def fn(**kwargs: Any) -> mcp_types.CallToolResult:
        try:
            text = await anyio.to_thread.run_sync(activate.tool_load, cwd(), session_id() or "")
        except Exception as e:  # noqa: BLE001 — the shim answers every call
            return _error(str(e) or f"load_thimble failed: {type(e).__name__}")
        return _result([{"type": "text", "text": text}], False)

    fn.__name__ = entry["name"]
    tool = Tool.from_function(fn, name=entry["name"], description=entry["description"])
    tool.parameters = entry["input_schema"]
    return tool


async def watch_workspace(server: MCPServer, connection: Connection) -> None:
    """While the shim lists load_thimble alone (listed): once Claude Code finished the handshake, look every RETRY_S
    whether the folder is a workspace; when it is, list the tools in its place and tell Claude Code once that the list
    changed (module note)."""
    await connection.initialized.wait()
    while not in_workspace():
        await anyio.sleep(RETRY_S)
    _set_tools(server, tool_entries())
    await connection.send_tool_list_changed()


async def serve(server: MCPServer) -> None:
    """MCPServer.run_stdio_async with, in the analyst's session, the subscription held beside the MCP session, and
    while the shim lists no tools, the look for the folder becoming a workspace (watch_workspace)."""
    low = server._lowlevel_server
    # the parent is the `claude` process; a session thimble starts itself hears no browser events (its main does), and
    # in terminal mode no server sends any (module note)
    route = None if own_session()[0] or terminal() else cc_plugin.route(cwd(), HERE.parents[1])
    if terminal():
        try:  # the card watch from the session's start, not its first call (local.begin)
            local.begin(cwd())
        except Exception:  # noqa: BLE001 — the tools still serve without it
            log.exception("the card watch did not start")
    options = low.create_initialization_options(NotificationOptions(tools_changed=True))
    try:
        async with stdio_server() as (read_stream, write_stream):
            async with anyio.create_task_group() as tg:
                if route:
                    tg.start_soon(subscription, route)
                # not low.run, which also serves 2026-07-28 (module note, Protocol); serve_loop's own dispatcher and
                # connection, built here so watch_workspace can tell Claude Code the list changed
                dispatcher = JSONRPCDispatcher(read_stream, write_stream, inline_methods=frozenset({"initialize"}))
                connection = Connection.for_loop(dispatcher)
                if [t.name for t in server._tool_manager.list_tools()] == [activate.LOAD_TOOL["name"]]:  # (listed)
                    tg.start_soon(watch_workspace, server, connection)
                async with low.lifespan(low) as lifespan_context:
                    await serve_connection(low, dispatcher, connection=connection, lifespan_state=lifespan_context,
                                           init_options=options)
                tg.cancel_scope.cancel()
    finally:
        if terminal():
            with anyio.CancelScope(shield=True):
                await local.close()


def listed() -> bool:
    """Whether the shim lists its tools from the start (module note): in a session thimble started, in terminal mode,
    or in a folder that is a workspace."""
    return bool(own_session()[0]) or terminal() or in_workspace()


def tool_entries() -> list[dict[str, Any]]:
    """The tools this shim lists (module note): its session kind's."""
    return tools.list(ROLE, session=own_session()[0])


def build_server() -> MCPServer:
    """The MCP server, with the tools and the instructions, or in a folder that is no workspace yet with no
    instructions and load_thimble alone (listed). Each listing is recorded for the session (listed.json, C4)."""
    if not listed():
        activate.write_listed(session_id() or "", [activate.LOAD_TOOL["name"]])
        return MCPServer(tools.SERVER_NAME, instructions=None, tools=[_load_tool()])
    entries = tool_entries()
    activate.write_listed(session_id() or "", [e["name"] for e in entries])
    return MCPServer(tools.SERVER_NAME, instructions=instructions() or None, tools=[_tool(e) for e in entries])


if __name__ == "__main__":
    if "--list" in sys.argv[1:]:  # a debugging aid: the tool list as JSON, no server involved
        json.dump(tool_entries(), sys.stdout, indent=1)
        sys.stdout.write("\n")
        sys.exit(0)
    if "--instructions" in sys.argv[1:]:  # a debugging aid: the instructions text, fetched as the server would be
        sys.stdout.write(instructions() + "\n")
        sys.exit(0)
    if terminal():
        terminal_stdout()
    anyio.run(serve, build_server())
