#!/bin/sh
# thimble's kernel as one command. Claude Code puts a plugin's bin/ folder on the Bash tool's PATH, so `thimble` runs
# as a bare command, through the session's permission mode like any other. The Python it runs: THIMBLE_PYTHON, else the
# plugin's own .venv, else python3. The kernel needs Python 3.10 or later and nothing else.
# a shell's thimble is a link to this file (scripts/install.sh): the plugin folder is the link's target's
self=$0
while [ -L "$self" ]; do
  to=$(readlink "$self")
  case $to in /*) self=$to ;; *) self=$(dirname "$self")/$to ;; esac
done
here=$(cd "$(dirname "$self")/.." && pwd)
# the way back from your fixes runs from the release, which no fix changes (engine/kernel/fixes.py): `thimble fix`,
# `thimble file`, `thimble update` and `thimble reapply` run the launcher of the release checkout in
# $THIMBLE_HOME/fixes/release, and that launcher hands the other commands to live's, so a fix to them works
fixes=${THIMBLE_HOME:-$HOME/.thimble}/fixes
release=$(cd "$fixes/release/plugin" 2>/dev/null && pwd -P)
if [ -n "$release" ] && [ -x "$release/bin/thimble" ]; then
  me=$(cd "$here" && pwd -P)
  case "$1" in
    fix|fixes|file|update|reapply)
      [ "$me" = "$release" ] || exec "$release/bin/thimble" "$@"
      # the checkout as the release commit (release.json's base) has it, before any of its code runs: a file changed in
      # it is restored and a file added to it removed (fixes.py place_release does the same)
      top=${release%/plugin}
      if [ "$(git -C "$top" rev-parse --show-toplevel 2>/dev/null)" = "$top" ]; then
        base=$(sed -n 's/^ *"base": *"\([0-9a-f]*\)".*/\1/p' "$fixes/release.json" 2>/dev/null | head -n 1)
        git -C "$top" checkout -q -f --detach "${base:-HEAD}" 2>/dev/null
        git -C "$top" clean -q -ffdx 2>/dev/null
      fi ;;
    *) if [ "$me" = "$release" ] && [ -x "$fixes/live/plugin/bin/thimble" ]; then exec "$fixes/live/plugin/bin/thimble" "$@"; fi ;;
  esac
fi
py=${THIMBLE_PYTHON:-}
if [ -z "$py" ] && [ -x "$here/.venv/bin/python" ]; then py="$here/.venv/bin/python"; fi
# for whoever works on thimble (not in its help): `thimble dev prompts`, the prompt registry (prompts/node.mjs);
# `thimble dev stats`, the session's cost and time per feature (telemetry/stats.mjs); and `thimble dev validate`, the
# check of a checker's answer that the plugin runs after each reply (engine/validate.py)
if [ "$1" = dev ]; then
  case "$2" in
    prompts) shift; exec node "$here/prompts/node.mjs" "$@";;
    stats) shift 2; exec node "$here/telemetry/stats.mjs" "$@";;
    validate) exec "${py:-python3}" "$here/engine/validate.py";;
  esac
fi
exec "${py:-python3}" "$here/engine/thimble.py" "$@"
