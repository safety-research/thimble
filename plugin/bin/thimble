#!/usr/bin/env bash
# thimble: the one command.
#
#   thimble [claude flags…]              `claude` in this folder with thimble's browser workbench opened at its start:
#                                        THIMBLE_OPEN=1, which the terminal UI presses home at session.start with, the
#                                        plugin loaded with --plugin-dir when Claude Code has not installed it, and
#                                        `/thimble browser` as the first prompt where Claude Code will not load thimble's
#                                        hooks module (below); every flag goes to `claude` as it is
#   thimble activate | guide | features [args]
#                                        turn thimble on in a session (app/activate.py), print or mark its guidance,
#                                        read or set the feature switches; the /thimble skill's and the hooks' commands
#   thimble open [--session <sid>] [--cwd <p>] [--ref <ref>] [--link] [--json]
#                                        open the browser workbench on this folder's session, signed in
#                                        (app/open_cmd.py): the press
#   thimble server up [--cwd <p>] [--session <sid>] [--action <a>]
#                                        start the server if needed, open this directory as a workspace, print the URL
#   thimble server status | repair | stop [--yes] | restart [--keep-vite] [--yes]
#   thimble update [--from <zip>]        bring the install up to date (the latest GitHub release via gh, or a zip)
#   thimble feedback ["description"] [--no-logs]
#                                        write a problem report (a zip) to send the developer, and say how to send it
#                                        (bash, below: it needs no server and no working supervisor)
#   thimble doctor [--verbose] | unpair | fix | revert | stop | restart | up
#                                        the supervisor's subcommands (backend/app/cli.py): doctor's checklist, or its
#                                        full detail; unpair signs out every browser; fix and revert only in a
#                                        development install (a git clone), since they change thimble's own code
#   thimble list                         the workspaces by id: each registered folder's, and its archived runs, with when
#                                        each was last used and the sessions open on it (backend/app/runs.py)
#   thimble purge <id>… [-y] [--dry-run] delete workspaces or archived runs by id, printing what went; never the folder a
#                                        workspace read or Claude Code's transcripts (backend/app/runs.py)
#   thimble plugin status                which thimble plugin Claude Code has (scripts/plugin.sh, bash: it needs no
#                                        venv)
#   thimble mode | cc-mod                print that thimble has no modes now and how to open the browser; change nothing
#   thimble state <surface> --cwd <p> [args] | act <kind> --cwd <p> (<json> | --stdin)
#                                        the terminal UI's reads and changes: the JSON a surface's GET route gives the
#                                        browser, or what a click's POST route does (backend/app/local.py)
#   thimble demo [name…] [--yes] [--dir <d>] [--attach] | --export <workspace> <out> [--outputs-only]
#                                        download the demo datasets from their public sources (asking first), each on
#                                        its pre-cached orientation where demos/ has one, open thimble's start page,
#                                        which lists them, in the browser, and print how to attach a session later;
#                                        --export writes a workspace whole, with its sessions' transcripts, and lists
#                                        what it holds (--outputs-only: the outputs alone, for demos/)
#                                        (backend/app/demo.py)
#   thimble demo --examples [--refresh]  for development and review: the worked examples of custom views
#                                        (plugin/viewers) as workspaces example-<name> on the same server, each on a copy
#                                        of its sample in $THIMBLE_HOME/examples with its view built, and open the start
#                                        page; --refresh copies them again (backend/app/demo_examples.py)
#   thimble launch-args [--cwd <p>] [--key <k>]
#                                        what a session starts with: the plugin folder to load, the tools that end a turn
#                                        without text, why the hooks module is off, and the note lines
#   thimble prompt <name>… [--cwd <p>]   prompt files rendered for a session in <p>; `prompt main --if-active
#                                        --unless-mod --session <sid>` is the SessionStart hook's for /clear and
#                                        /compact; in a session thimble started in its own work folder, the ones its
#                                        server rendered (rendered_prompts, below)
#   thimble uninstall [--yes] [--keep-home]
#                                        remove the install: the plugin registration, ~/.local/bin/thimble, the lines
#                                        install.sh added to shell startup files, $THIMBLE_HOME (bash, below: it needs no
#                                        venv; a clone folder is left in place)
#
#   thimble status                       one line: the server, the orientation, the queue (`server status`)
#   thimble help | -h | --help           thimble's usage (usage, below): the commands an analyst uses; server, status,
#                                        launch-args, prompt, activate, guide, features, state and act are left out, and
#                                        fix and revert are listed only in a development install
#
# Dispatch: no arguments, or a first argument that starts with `-`, launches a session (the arguments go to `claude`);
# a supervisor subcommand runs backend/app/cli.py with THIMBLE_CALLER_CWD set; any other word prints the usage and
# exits 2. This file is reached through the ~/.local/bin/thimble symlink, so its directory comes from the resolved $0.
set -euo pipefail
resolve_link() {  # resolve_link PATH: the file a chain of symlinks ends at, as an absolute path (readlink -f is not on every macOS);
  # exit 1 when the chain ends at nothing or runs past 40 hops (a cycle)
  local p="$1" t n=0
  while [ -L "$p" ]; do
    n=$((n + 1)); [ "$n" -le 40 ] || return 1
    t="$(readlink "$p")"; case "$t" in /*) p="$t";; *) p="$(dirname "$p")/$t";; esac
  done
  [ -e "$p" ] || return 1
  printf '%s/%s\n' "$(cd "$(dirname "$p")" && pwd -P)" "$(basename "$p")"
}
self="$(resolve_link "${BASH_SOURCE[0]}")"
here="$(dirname "$self")"
plugin="$(cd "$here/.." && pwd -P)"

# the supervisor's subcommands (backend/app/cli.py build_parser) plus the `server` group; `up` is an alias of `ensure`.
# `uninstall` is the bash function below, so it works with backend/.venv missing or broken.
SUPERVISOR_COMMANDS=" server up ensure stop restart doctor unpair fix revert update list purge extension launch-args prompt demo "

# usage: what `thimble help` prints, the commands an analyst uses; the header above has the details. `server`,
# `status`, `launch-args`, `prompt`, `activate`, `guide`, `features`, `state` and `act` run when typed and are not listed
# (CONTRIBUTING.md has them).
# `fix` and `revert` change thimble's own code, which only a development install can do, so they are listed there
# alone.
usage() {
  cat <<'EOF'
usage: thimble [claude flags...]          start Claude Code in this folder with thimble's browser workbench
                                          open (the cards, report and labels stay)
       thimble open                       open the browser workbench on this folder's Claude Code session
       thimble demo [name...] [--yes] [--dir <d>] [--attach]
                                          download public datasets (collusion-wiki, mythos-5,
                                          transluce-urlquery), asking first, and open the start page that
                                          lists them
       thimble demo --export <workspace> <out> [--outputs-only]
                                          write a workspace whole, with its sessions' transcripts;
                                          --outputs-only writes the outputs alone
       thimble list                       the workspaces by id: each folder's, and its archived runs
       thimble purge <id>... [-y] [--dry-run]
                                          delete workspaces or archived runs by id, after asking
       thimble extension add <folder | git URL | name> [--yes] | on <name> | off <name> | list | remove <name>
                                          add, switch on or off, list or remove extensions
       thimble plugin status              which thimble plugin Claude Code has
       thimble doctor [--verbose]         a checklist of what works, with the fix for each problem
       thimble unpair                     sign out every browser
       thimble feedback ["what went wrong"] [--no-logs]
                                          write a problem report to send the developer
       thimble update [--from <zip>]      bring the install up to date
       thimble uninstall [--yes] [--keep-home]
                                          remove thimble from this machine
EOF
  dev_install || return 0
  cat <<'EOF'

in a development install (a git clone of thimble):
       thimble fix                        repair a server that will not start, with thimble's dev agent
       thimble revert                     undo the last change thimble's dev agent applied
EOF
}

# dev_install: true when this copy's tree (bin/thimble-app-dir) is a development install, a git clone of thimble (a
# release install is a git repository too, for code tickets, and carries RELEASE.json)
dev_install() {
  local repo
  repo="$("$here/thimble-app-dir" 2>/dev/null)" || return 1
  [ -e "$repo/.git" ] && [ ! -f "$repo/RELEASE.json" ]
}

# rendered_prompts NAME… [--cwd P]: `prompt` in a session thimble started in a work folder of its own. The server has
# rendered the prompts for the session's corpus into $THIMBLE_RENDERED_PROMPTS/<name>.md; print them from there.
# Returns 1 with nothing printed (so the supervisor answers) when the variable is unset, the session has no
# THIMBLE_SESSION_TOKEN (a variable Claude Code's background service handed on from another session), a name has no
# file, or another option is given.
rendered_prompts() {
  local dir="${THIMBLE_RENDERED_PROMPTS:-}" names="" n sep=""
  [ -n "$dir" ] && [ -n "${THIMBLE_SESSION_TOKEN:-}" ] || return 1
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --cwd) [ "$#" -ge 2 ] || return 1; shift 2;;
      --cwd=*) shift;;
      "" | -* | *[!A-Za-z0-9_-]*) return 1;;
      *) [ -r "$dir/$1.md" ] || return 1; names="$names $1"; shift;;
    esac
  done
  [ -n "$names" ] || return 1
  for n in $names; do printf '%s' "$sep"; cat "$dir/$n.md"; sep=$'\n'; done
}

# feedback [--skill] ARGS…: the problem report (backend/app/feedback.py), run as that module alone so it works when the
# server or the backend is broken (it imports only the standard library). It runs with the tree's venv, else python3.
# --skill is /thimble feedback's: every line starts `thimble:` and it exits 0, since a skill fails on a non-zero exit.
feedback() {
  local repo py skill=0 rc=1
  [ "${1:-}" != --skill ] || skill=1
  repo="$("$here/thimble-app-dir" 2>/dev/null)" || repo="$(cd "$plugin/.." && pwd -P)"
  if [ ! -f "$repo/backend/app/feedback.py" ]; then
    printf 'thimble: the problem report cannot be written: %s holds no backend/app/feedback.py\n' "$repo"
    [ "$skill" = 1 ] && exit 0; exit 1
  fi
  export THIMBLE_CALLER_CWD="${THIMBLE_CALLER_CWD:-$PWD}" THIMBLE_APP_DIR="$repo"
  cd "$repo/backend"
  for py in "$repo/backend/.venv/bin/python" python3; do
    command -v "$py" >/dev/null 2>&1 || continue
    if "$py" -m app.feedback "$@"; then exit 0; else rc=$?; fi
    printf 'thimble: %s could not write the report (exit %s)%s\n' "$py" "$rc" "$( [ "$py" = python3 ] || echo '; trying python3' )"
  done
  [ "$skill" = 1 ] && exit 0; exit "$rc"
}

# thimble uninstall [--yes] [--keep-home]: bash, so it works when the venv is missing or inside the tree being removed.
# It touches only the plugin registration and the trust entry install.sh added, the lines install.sh added to shell
# startup files (recorded in $THIMBLE_HOME/shell-startup: exactly those lines go, and a file it created goes once it holds
# nothing else), ~/.local/bin/thimble (the link in $THIMBLE_BIN_DIR, when set, as install.sh puts it there) and
# $THIMBLE_HOME; a tree outside $THIMBLE_HOME (a clone) is left in place with
# its workspaces. The `rm -rf` is guarded:
# $THIMBLE_HOME is canonicalized once, `/`, $HOME and relative paths are refused, and it is removed only when it holds
# thimble state. The recorded
# server is stopped only when its command line is a thimble server on the recorded port (argv[0] is not checked, since
# macOS ps shows the venv's python as the framework binary) and the port confirms it (lsof, ss or /api/health); the
# check is repeated before each signal. Stopping escalates from `thimble stop` to TERM to KILL, 5 s apart. What thimble
# changed in Claude Code's files, recorded in $THIMBLE_HOME (the trust of its workspaces folder, and keys an older
# version wrote into folders' .claude/settings.local.json), is put back before anything is removed
# (backend/app/claude_changes.py, run with python3, else the tree's venv). A failing step does not stop the others; the
# last block lists what is left (exit 1 only then).
uninstall() {
  local yes=0 keep_home=0 arg
  for arg in "$@"; do
    case "$arg" in
      --yes | -y) yes=1;;
      --keep-home) keep_home=1;;
      -h | --help)
        printf 'usage: thimble uninstall [--yes] [--keep-home]\n'
        printf '  --yes        remove without asking\n'
        printf '  --keep-home  keep ~/.thimble (server state; after a release install also the app copy and its workspaces); remove only the plugin registration, the link, the lines install.sh added to shell startup files, and the sign-in files and session markers in it\n'
        exit 0;;
      *) printf 'thimble uninstall: unknown argument %s\n' "$arg" >&2; exit 2;;
    esac
  done
  [ -n "${HOME:-}" ] || { printf 'thimble uninstall: HOME is not set\n' >&2; exit 2; }
  local home_raw="${THIMBLE_HOME:-}" home home_note="" home_state=0 link="${THIMBLE_BIN_DIR:-$HOME/.local/bin}/thimble" tree="" kind="" name="" name_note=""
  local inside=0 pid="" port="" pid_note="" conf="" planned="" pport="" link_ours=0 link_why="" stop_how="" have_claude=0 ans cwd rc
  local nsteps=0 ndone=0 nleft=0 left="" id_ok=0 id_conf="" id_note="" changed=0 undo=0 undo_py="" undo_cmd="" undone=1
  local reg="" reg_ok=1 reg_from="" reg_other="" mkt="" sh_record="" sh_files=() sh_ok=1 kind_ f_ line_ sess=() s_
  case "$home_raw" in *[![:space:]]*) ;; *) home_raw="$HOME/.thimble";; esac   # unset or blank: the default
  home="${home_raw%/}"; [ -n "$home" ] || home=/
  enable -n kill 2>/dev/null || true   # `kill` is the program on PATH, not the builtin: the `+ kill …` line names what ran, and a test can stand a failing one in for it
  is_tree() { [ -n "$1" ] && [ -f "$1/backend/pyproject.toml" ] && [ -d "$1/plugin/bin" ]; }
  alive() {  # alive PID: a live, non-zombie process (ps, so it needs no kill; a zombie stays until its parent reaps it)
    local st; st="$(ps -o stat= -p "$1" 2>/dev/null || true)"; st="${st#"${st%%[![:space:]]*}"}"
    case "$st" in "" | Z*) return 1;; *) return 0;; esac
  }
  wait_dead() {  # wait_dead PID TENTHS: up to TENTHS × 0.1 s for the pid to go
    local _i=0; while alive "$1" && [ "$_i" -lt "$2" ]; do sleep 0.1; _i=$((_i + 1)); done
  }
  run() { printf '+'; printf ' %q' "$@"; printf '\n'; "$@"; }
  step() { nsteps=$((nsteps + 1)); printf '  %d. %s\n' "$nsteps" "$1"; }   # a line of the plan that y runs
  add_left() { nleft=$((nleft + 1)); left="$left  $1"$'\n'"    $2"$'\n'; }   # add_left WHAT-WAS-NOT-DONE COMMAND-TO-FINISH
  json_get() {  # json_get FILE KEY — a top-level string value (python3 when present, else a sed for the flat case); 1 when unreadable
    if command -v python3 >/dev/null 2>&1; then python3 -I -c 'import json,sys; v=json.load(open(sys.argv[1])).get(sys.argv[2], ""); print(v if isinstance(v, str) else "")' "$1" "$2" 2>/dev/null
    else sed -n "s/.*\"$2\": *\"\([^\"]*\)\".*/\1/p" "$1" | head -n 1; fi
  }
  json_num() {  # json_num FILE KEY — a top-level integer value, else nothing
    if command -v python3 >/dev/null 2>&1; then python3 -I -c 'import json,sys; v=json.load(open(sys.argv[1])).get(sys.argv[2]); print(v if isinstance(v, int) and not isinstance(v, bool) else "")' "$1" "$2" 2>/dev/null || true
    else sed -n "s/.*\"$2\": *\([0-9][0-9]*\).*/\1/p" "$1" | head -n 1; fi
  }
  sh_lines_of() {  # sh_lines_of FILE: the lines install.sh's record says it added to FILE, that FILE still has
    local k f l
    while IFS=$'\t' read -r k f l; do
      if [ "$k" = added ] && [ "$f" = "$1" ] && grep -qxF -- "$l" "$1"; then printf '%s\n' "$l"; fi
    done < "$sh_record"
  }
  sh_created() { grep -qxF -- "created"$'\t'"$1" "$sh_record"; }  # sh_created FILE: install.sh created FILE
  sh_without() {  # sh_without FILE: FILE's text without the lines install.sh added to it, every other byte as it was
    local l t; t="$(mktemp)" || return 1
    cp "$1" "$t" || { rm -f "$t"; return 1; }
    while IFS= read -r l; do
      { grep -vxF -- "$l" "$t" || true; } > "$t.next" && mv "$t.next" "$t" || { rm -f "$t" "$t.next"; return 1; }
    done < <(sh_lines_of "$1")
    cat "$t"; rm -f "$t"
  }
  sh_goes() { sh_created "$1" && ! sh_without "$1" | grep -q '[^[:space:]]'; }  # sh_goes FILE: install.sh created FILE, and nothing else is in it
  sh_take_back() {  # sh_take_back FILE: FILE without the lines install.sh added, written in place (a link stays a link),
    # or removed when sh_goes
    local f="$1" l t
    while IFS= read -r l; do printf '+ remove from %s: %s\n' "$f" "$l"; done < <(sh_lines_of "$f")
    if sh_goes "$f"; then run rm -f "$f"; return; fi
    t="$(mktemp)" || return 1
    if sh_without "$f" > "$t" && cat "$t" > "$f"; then rm -f "$t"; else rm -f "$t"; return 1; fi
  }
  read_record() {  # read_record: pid and port from $home/server.json into pid and port — positive integers only (a pid of 0 would
    # reach ps: on macOS `ps -p 0` shows kernel_task, and `kill 0` in the by-hand line would signal the user's own process group)
    pid=""; port=""
    [ -f "$home/server.json" ] || return 0
    pid="$(json_num "$home/server.json" pid)"; port="$(json_num "$home/server.json" port)"
    case "$pid" in '' | 0 | -*) pid="";; esac
    case "$port" in '' | 0 | -*) port="";; esac
  }
  is_ours() {  # is_ours PID PORT: the command line of PID is a thimble server on PORT (uvicorn, app.main:app, `--port PORT` as a
    # whole word; argv[0] is not checked, see above) — the test repeated before every signal
    local args re; args="$(ps -ww -o args= -p "$1" 2>/dev/null || true)"; re="[[:space:]]--port(=|[[:space:]]+)$2[[:space:]]"
    [[ "$args" == *uvicorn* && "$args" == *app.main:app* && " $args " =~ $re ]]
  }
  identify() {  # identify PID PORT (PID alive): this install's server on PORT? id_ok=1 and id_conf (what confirmed the port) when
    # is_ours holds and the port agrees — the pid is listening on it (lsof; ss on a Linux without lsof) or /api/health answers
    # on it while the pid lives; with neither lsof nor ss present the command line alone decides. Else id_ok=0 and id_note
    # says what the record is instead: the by-hand `kill` is offered only for a pid whose command line IS a thimble server
    local _pid="$1" _port="$2" args listen=""
    id_ok=0; id_conf=""; id_note=""
    if [ -z "$_port" ]; then
      id_note="server.json names pid $_pid but records no port, so it cannot be checked; left alone. Look at it with ps -p $_pid -o command= and kill it only if it is a thimble server"
      return 0
    fi
    args="$(ps -ww -o args= -p "$_pid" 2>/dev/null || true)"
    if [[ "$args" != *uvicorn* || "$args" != *app.main:app* ]]; then
      id_note="server.json's record is stale: pid $_pid is another program now, not a thimble server; nothing to stop (ps -p $_pid -o command= shows what it is)"
      return 0
    fi
    if ! is_ours "$_pid" "$_port"; then
      id_note="server.json's record is stale: pid $_pid is a thimble server, but not the one on port $_port (its command line names another port); left alone (ps -p $_pid -o command= shows it)"
      return 0
    fi
    if command -v lsof >/dev/null 2>&1; then
      listen=lsof; ! lsof -t -nP -iTCP:"$_port" -sTCP:LISTEN 2>/dev/null | grep -qx "$_pid" || id_conf="listening on port $_port"
    elif command -v ss >/dev/null 2>&1; then
      listen=ss; ! ss -ltnp "( sport = :$_port )" 2>/dev/null | grep -q "pid=$_pid," || id_conf="listening on port $_port"
    fi
    if [ -z "$id_conf" ] && command -v curl >/dev/null 2>&1 && curl -s -m 3 "http://127.0.0.1:$_port/api/health" 2>/dev/null | grep -q '"ok": *true' && alive "$_pid"; then id_conf="answering /api/health on port $_port"; fi
    [ -n "$id_conf" ] || [ -n "$listen" ] || id_conf="port $_port by its command line; neither lsof nor ss is installed to confirm it listens"
    if [ -n "$id_conf" ]; then id_ok=1
    else id_note="server.json names pid $_pid and its command line is a thimble server on port $_port, but that pid is not listening on port $_port ($listen) and /api/health does not answer there; left alone"$'\n'"  to stop it by hand: check it with ps -p $_pid -o command=, then kill $_pid"; fi
    return 0
  }

  # $THIMBLE_HOME, canonical: refused when relative, `/` or the home directory; a link is followed and the real directory named
  case "$home" in /*) ;; *) printf 'thimble uninstall: THIMBLE_HOME=%s is not an absolute path; nothing removed\n' "$home_raw" >&2; exit 2;; esac
  if [ -d "$home" ]; then home="$(cd "$home" && pwd -P)"; fi
  if [ "$home" = / ] || [ "$home" = "$HOME" ] || [ "$home" = "$(cd "$HOME" 2>/dev/null && pwd -P || printf '%s' "$HOME")" ]; then
    printf 'thimble uninstall: THIMBLE_HOME=%s is %s; refusing to remove it, nothing removed\n' "$home_raw" "$( [ "$home" = / ] && echo 'the root directory' || echo 'your home directory' )" >&2; exit 2
  fi
  [ "$home" = "${home_raw%/}" ] || home_note=" (THIMBLE_HOME=$home_raw resolves to it)"
  if [ -f "$home/app-dir" ] || [ -f "$home/server.json" ] || [ -f "$home/server.lock" ] || [ -d "$home/workspaces" ] || [ -d "$home/data" ] || is_tree "$home/app"; then home_state=1; fi
  # the tree: the install $THIMBLE_HOME/app-dir names, else the one this copy sits in
  if [ -f "$home/app-dir" ] && is_tree "$(head -n 1 "$home/app-dir")"; then tree="$(cd "$(head -n 1 "$home/app-dir")" && pwd -P)"
  elif is_tree "$plugin/.."; then tree="$(cd "$plugin/.." && pwd -P)"; fi
  if [ -n "$tree" ]; then
    if [ -e "$tree/.git" ] && [ ! -f "$tree/RELEASE.json" ]; then kind="git checkout"; else kind="release copy"; fi
    case "$tree/" in "$home"/*) inside=1;; esac
    if [ -f "$tree/.claude-plugin/marketplace.json" ]; then
      if ! name="$(json_get "$tree/.claude-plugin/marketplace.json" name)"; then name=""; name_note="$tree/.claude-plugin/marketplace.json is unreadable; guessing the marketplace name"; fi
    fi
  fi
  if [ -z "$name" ]; then if [ "$inside" = 1 ] || [ -z "$tree" ]; then name=thimble-local; else name=thimble; fi; fi
  ! command -v claude >/dev/null 2>&1 || have_claude=1
  # the plugin registration, removed only when install.sh added it: $home/plugin.json names the marketplace it registered
  # thimble under, "" after a no. Without that record (an install older than its question, which registered the plugin
  # unasked) it goes when Claude Code lists it, or, with no claude to ask, the commands are printed. Either way it stays
  # when Claude Code has that marketplace from a folder other than this tree: it is another install's
  if [ -f "$home/plugin.json" ]; then reg="$(json_get "$home/plugin.json" registered || true)"
  elif [ "$have_claude" = 0 ]; then reg="$name"
  else case "$(claude plugin list --json 2>/dev/null || true)" in *"\"thimble@$name\""*) reg="$name";; esac; fi
  market_from() {  # market_from NAME: the folder Claude Code has marketplace NAME from (else its source), or nothing
    claude plugin marketplace list --json 2>/dev/null | python3 -I -c 'import json, os, sys
try:
    rows = json.load(sys.stdin)
except ValueError:
    rows = []
for m in rows if isinstance(rows, list) else []:
    if isinstance(m, dict) and m.get("name") == sys.argv[1]:
        src = m.get("source")
        kind, path = (src.get("source"), src.get("path")) if isinstance(src, dict) else (src, m.get("path"))
        print(os.path.realpath(path) if kind == "directory" and isinstance(path, str) and path else kind or "an unknown source")
        break' "$1" || true
  }
  if [ -n "$reg" ] && [ -n "$tree" ] && [ "$have_claude" = 1 ] && command -v python3 >/dev/null 2>&1; then
    reg_from="$(market_from "$reg")"
    if [ -n "$reg_from" ] && [ "$reg_from" != "$tree" ]; then reg_other="$reg"; reg=""; fi
  fi
  # the marketplace alone: Claude Code has $name from this tree and no thimble plugin of install.sh's is registered with
  # it (an earlier version registered it for a plugin this version no longer has). It goes too
  if [ -n "$tree" ] && [ "$have_claude" = 1 ] && command -v python3 >/dev/null 2>&1; then
    if [ -z "$reg" ] && [ -z "$reg_other" ] && [ "$(market_from "$name")" = "$tree" ]; then mkt="$name"; fi
  fi
  # the link: ours when it ends at this tree's plugin/bin/thimble, or is a thimble link (…/plugin/bin/thimble) whose target
  # is gone or lies inside $THIMBLE_HOME — it would dangle after the rm
  if [ -L "$link" ]; then
    local target ends; target="$(readlink "$link")"; ends="$(resolve_link "$link" 2>/dev/null || true)"
    if [ -n "$tree" ] && [ "$ends" = "$tree/plugin/bin/thimble" ]; then link_ours=1; link_why="the link into this tree"
    else
      case "$target" in */plugin/bin/thimble)
        if [ ! -e "$link" ]; then link_ours=1; link_why="a broken link into a removed thimble tree"
        else case "$ends/" in "$home"/*) link_ours=1; link_why="a link into $home";; esac; fi;;
      esac
    fi
  fi
  read_record
  # a running server: server.json's pid, alive, this install's server by identify; anything else is left alone, with what it is
  if [ -n "$pid" ]; then
    if alive "$pid"; then
      identify "$pid" "$port"
      if [ "$id_ok" = 1 ]; then
        conf="$id_conf"; if [ -n "$tree" ] && [ -x "$tree/backend/.venv/bin/python" ]; then stop_how=supervisor; else stop_how=kill; fi
      else pid_note="$id_note"; pid=""; fi
    else pid=""; fi
  fi

  # the plan: the steps y runs, numbered, each as the command it runs or the file it removes; what is left alone or in
  # place, unnumbered; then the count
  printf 'thimble uninstall will:\n'
  [ -n "$tree" ] || printf '  (no thimble tree found: %s/app-dir names none; the plugin is taken to be thimble@%s)\n' "$home" "$name"
  [ -z "$name_note" ] || printf '  %s\n' "$name_note"
  [ -z "$pid" ] || step "stop the thimble server this install recorded (pid $pid, $conf)"
  [ -z "$pid_note" ] || printf '  %s\n' "$pid_note"
  # what thimble changed in Claude Code's files, recorded in $home: put back with python3, else the tree's venv
  if [ -f "$home/trust.json" ] || [ -f "$home/trusted-folders.json" ] || [ -f "$home/effort-overrides.json" ] || [ -f "$home/fast-overrides.json" ] || [ -f "$home/statusline-overrides.json" ]; then
    undo=1 undo_cmd="THIMBLE_HOME=$home python3 -I <a thimble tree>/backend/app/claude_changes.py undo"
    if [ -n "$tree" ] && [ -f "$tree/backend/app/claude_changes.py" ]; then
      if command -v python3 >/dev/null 2>&1; then undo_py=python3
      elif [ -x "$tree/backend/.venv/bin/python" ]; then undo_py="$tree/backend/.venv/bin/python"; fi
    fi
    if [ -n "$undo_py" ]; then step "put back what thimble changed in Claude Code's files: the trust of its workspaces folder, if install.sh added it"
    else printf "  what thimble changed in Claude Code's files cannot be put back here (no thimble tree with a Python to run it); run this yourself:\n    %s\n" "$undo_cmd"; fi
  fi
  if [ -n "$reg_other" ]; then
    printf "  thimble's plugin: thimble@%s is another install's, from %s, so it is left as it is\n" "$reg_other" "$reg_from"
  elif [ -z "$reg" ] && [ -n "$mkt" ]; then
    step "claude plugin marketplace remove $mkt (thimble's marketplace, which an earlier version registered; thimble's plugin was not registered with it)"
  elif [ -z "$reg" ] && [ -f "$home/plugin.json" ]; then
    printf "  thimble's plugin: install.sh did not register it (answered no), so nothing is removed there\n"
  elif [ -z "$reg" ]; then
    printf "  thimble's plugin: Claude Code does not list thimble@%s, so nothing is removed there\n" "$name"
  elif [ "$have_claude" = 1 ]; then
    step "claude plugin uninstall thimble@$reg"
    step "claude plugin marketplace remove $reg"
  else
    printf '  claude is not on PATH; run these yourself when it is:\n    claude plugin uninstall thimble@%s\n    claude plugin marketplace remove %s\n' "$reg" "$reg"
  fi
  if [ "$link_ours" = 1 ]; then step "rm $link ($link_why)"
  elif [ -e "$link" ] || [ -L "$link" ]; then printf '  %s is left alone: not a link into this tree\n' "$link"; fi
  # the lines install.sh added to shell startup files, which its record names: one step per file that still has one
  [ ! -f "$home/shell-startup" ] || sh_record="$home/shell-startup"
  if [ -n "$sh_record" ]; then
    while IFS=$'\t' read -r kind_ f_ line_; do
      [ "$kind_" = added ] && [ -f "$f_" ] && grep -qxF -- "$line_" "$f_" || continue
      case " ${sh_files[*]+"${sh_files[*]}"} " in *" $f_ "*) continue;; esac
      sh_files+=("$f_")
    done < "$sh_record"
    for f_ in ${sh_files[@]+"${sh_files[@]}"}; do
      step "remove from $f_ the lines install.sh added$(sh_goes "$f_" && echo ', and the file, which it created and which holds nothing else'):"
      sh_lines_of "$f_" | while IFS= read -r line_; do printf '       %s\n' "$line_"; done
    done
  fi
  # what $THIMBLE_HOME holds: the registry of folders (data/) and server state; the app copy and its workspaces
  # only when the tree is inside it
  local holds="the registry of folders you opened with /thimble (data/) and server state (app-dir, server.json, server.log)"
  [ "$inside" = 0 ] || holds="workspaces (your notebooks, labels and reports), the registry of folders you opened with /thimble (data/), server state and the release copy at $tree"
  # what a kept home must not keep: the press's sign-in files and one-time links (open/, links/), and the markers of the
  # sessions (up/, with their guide markers) and folders (active/) thimble was on in, which the plugin's hooks look for
  for s_ in open links up active; do [ ! -e "$home/$s_" ] || sess+=("$home/$s_"); done
  if [ "$keep_home" = 1 ] && [ ${#sess[@]} -gt 0 ]; then
    step "rm -rf ${sess[*]}: the browser's sign-in files and one-time links, and the markers of the sessions and folders thimble was on in"
  fi
  if [ "$keep_home" = 1 ]; then printf '  %s is kept (--keep-home): %s\n' "$home" "$holds"
  elif [ "$home_state" = 1 ]; then step "rm -rf $home$home_note: $holds (--keep-home keeps it)"
  elif [ -e "$home" ]; then printf '  %s holds no thimble state; left alone\n' "$home"; fi
  if [ -n "$tree" ] && [ "$inside" = 0 ]; then
    if [ "$kind" = "git checkout" ]; then printf '  the clone at %s is left in place, with your workspaces (notebooks, labels, reports) in %s/workspaces (delete the folder yourself if you want it gone)\n' "$tree" "$tree"
    else printf '  the tree at %s is left in place, with your workspaces (notebooks, labels, reports) in %s/workspaces: it is outside %s (delete the folder yourself if you want it gone)\n' "$tree" "$tree" "$home"; fi
  fi
  if [ "$yes" = 1 ]; then printf '%d steps (--yes: running them)\n' "$nsteps"
  else
    printf '%d steps; y runs them.\nRemove? [y/N] ' "$nsteps"
    read -r ans 2>/dev/null || ans=""
    case "$ans" in y | Y | yes | YES | Yes) ;; *) printf 'nothing removed\n'; exit 0;; esac
  fi

  # the steps, in the plan's order; a failing one is noted and the rest runs; the last block says what is left
  if [ -n "$pid" ]; then
    # the identity again (see above): the server server.json names now, or the planned pid when it is still a thimble server on
    # its port and the record no longer names it; a record that names nothing to stop leaves the planned pid unsignalled
    planned="$pid"; pport="$port"; pid=""
    read_record
    if [ -n "$pid" ] && alive "$pid" && { identify "$pid" "$port"; [ "$id_ok" = 1 ]; }; then
      [ "$pid" = "$planned" ] || printf '(server.json now names pid %s, not pid %s as when the plan was printed; stopping pid %s, the server it records, %s)\n' "$pid" "$planned" "$pid" "$id_conf"
    elif alive "$planned" && { identify "$planned" "$pport"; [ "$id_ok" = 1 ]; }; then
      pid="$planned"; port="$pport"
      printf '(server.json no longer names pid %s, but it is still a thimble server, %s; stopping it as planned)\n' "$planned" "$id_conf"
    else
      if alive "$planned"; then
        add_left "the thimble server was not stopped: server.json changed while the question was open, and pid $planned is no longer confirmed as a thimble server on port $pport (${id_note%%$'\n'*})" "ps -p $planned -o command=   # kill $planned only if it is a thimble server"
      elif [ -n "$pid" ] && alive "$pid"; then
        add_left "the thimble server was not stopped: server.json changed while the question was open; pid $planned is gone, and the pid it names now is not confirmed as a thimble server (${id_note%%$'\n'*})" "ps -p $pid -o command=   # kill $pid only if it is a thimble server"
      else
        printf '(pid %s is gone already: nothing to stop)\n' "$planned"; ndone=$((ndone + 1))
      fi
      pid=""
    fi
  fi
  if [ -n "$pid" ]; then
    if [ "$stop_how" = supervisor ]; then
      run "$tree/plugin/bin/thimble" stop --yes || printf '(thimble stop failed (exit %s); stopping pid %s with kill)\n' "$?" "$pid"
      wait_dead "$pid" 50
    fi
    # the command line once more before each signal: a pid that is no longer a thimble server on the port is not signalled
    if alive "$pid"; then if is_ours "$pid" "$port"; then run kill -TERM "$pid" || true; wait_dead "$pid" 50; else changed=1; fi; fi
    if [ "$changed" = 0 ] && alive "$pid"; then if is_ours "$pid" "$port"; then run kill -KILL "$pid" || true; wait_dead "$pid" 20; else changed=1; fi; fi
    if [ "$changed" = 1 ]; then add_left "pid $pid was not signaled: its command line stopped being a thimble server on port $port before the signal" "ps -p $pid -o command=   # kill $pid only if it is a thimble server"
    elif alive "$pid"; then add_left "the thimble server (pid $pid) is still running" "kill -KILL $pid"
    else ndone=$((ndone + 1)); fi
  fi
  if [ "$undo" = 1 ]; then
    if [ -n "$undo_py" ] && THIMBLE_HOME="$home" "$undo_py" -I "$tree/backend/app/claude_changes.py" undo; then ndone=$((ndone + 1))
    else add_left "what thimble changed in Claude Code's files was not put back" "$undo_cmd"; undone=0; fi
  fi
  if [ -n "$reg" ] && [ "$have_claude" = 1 ]; then
    if run claude plugin uninstall "thimble@$reg"; then ndone=$((ndone + 1))
    else rc=$?; reg_ok=0; printf '(exit %s)\n' "$rc"; add_left "claude plugin uninstall thimble@$reg failed (exit $rc)" "claude plugin uninstall thimble@$reg"; fi
    if run claude plugin marketplace remove "$reg"; then ndone=$((ndone + 1))
    else rc=$?; reg_ok=0; printf '(exit %s)\n' "$rc"; add_left "claude plugin marketplace remove $reg failed (exit $rc)" "claude plugin marketplace remove $reg"; fi
  elif [ -n "$reg" ]; then
    reg_ok=0; add_left "claude is not on PATH, so the plugin is still registered" "claude plugin uninstall thimble@$reg && claude plugin marketplace remove $reg"
  elif [ -n "$mkt" ]; then
    if run claude plugin marketplace remove "$mkt"; then ndone=$((ndone + 1))
    else rc=$?; printf '(exit %s)\n' "$rc"; add_left "claude plugin marketplace remove $mkt failed (exit $rc)" "claude plugin marketplace remove $mkt"; fi
  fi
  # the record goes with what it records, --keep-home or not, so that a later install asks again
  [ "$reg_ok" = 0 ] || rm -f "$home/plugin.json"
  if [ "$link_ours" = 1 ]; then
    if run rm -f "$link"; then ndone=$((ndone + 1)); else add_left "$link was not removed" "rm -f $link"; fi
  fi
  for f_ in ${sh_files[@]+"${sh_files[@]}"}; do
    if sh_take_back "$f_"; then ndone=$((ndone + 1))
    else sh_ok=0; add_left "the lines install.sh added to $f_ are still there" "remove from $f_ each line that ends with: # added by thimble's installer"; fi
  done
  # the record goes with what it records, --keep-home or not
  [ -z "$sh_record" ] || [ "$sh_ok" = 0 ] || rm -f "$sh_record"
  if [ ${#sess[@]} -gt 0 ] && { [ "$keep_home" = 1 ] || { [ "$home_state" = 1 ] && [ "$undone" = 0 ]; }; }; then
    if run rm -rf "${sess[@]}"; then [ "$keep_home" != 1 ] || ndone=$((ndone + 1))
    else add_left "the sign-in files and session markers in $home were not removed" "rm -rf ${sess[*]}"; fi
  fi
  if [ "$keep_home" != 1 ] && [ "$home_state" = 1 ] && [ "$undone" = 0 ]; then
    add_left "$home was kept: it records what the command above puts back" "rm -rf $home   # once that has run"
  elif [ "$keep_home" != 1 ] && [ "$home_state" = 1 ]; then
    cwd="$(pwd -P 2>/dev/null || printf '%s' "$PWD")"
    if run rm -rf "$home"; then
      ndone=$((ndone + 1))
      case "$cwd/" in "$home"/*) printf "your shell's current directory was removed; cd somewhere else\\n";; esac
    else add_left "$home was not removed" "rm -rf $home"; fi
  fi
  if [ "$nleft" = 0 ]; then printf 'thimble uninstall: done (%d steps)\n' "$ndone"; exit 0; fi
  printf 'thimble uninstall: %d of %d steps done. Left for you to do:\n%s' "$ndone" "$nsteps" "$left"; exit 1
}

case "${1:-}" in
  help | -h | --help)
    usage; exit 0;;
  "" | -*)
    ;;  # a session: below
  uninstall)
    shift; uninstall "$@";;
  feedback)
    shift; feedback "$@";;
  plugin)
    # scripts/plugin.sh of the tree this copy belongs to (bin/thimble-app-dir), which registers it with `claude plugin`
    shift
    repo="$("$here/thimble-app-dir" 2>&1)" || { printf '%s\n' "$repo" >&2; exit 1; }
    [ -f "$repo/scripts/plugin.sh" ] || { printf 'thimble plugin: %s has no scripts/plugin.sh (an install older than 0.6.0): run thimble update first\n' "$repo" >&2; exit 1; }
    exec bash "$repo/scripts/plugin.sh" "$@";;
  status)
    shift; exec "$self" server status "$@";;
  mode | cc-mod)
    # 0.8.0's `thimble mode` and 0.5.0's `thimble cc-mod` chose where thimble showed its work; 0.9.0 has no modes, so
    # each says how to open the browser, and changes nothing
    printf '%s\n' "thimble has no modes now. Type /thimble browser, or press o in thimble's panel, to open the browser."
    exit 0;;
  activate | guide | features)
    # 0.9.0: thimble turned on in a session, its guide, the feature switches (backend/app/activate.py, guide.py,
    # features.py); JSON or the guide on stdout, exit 0
    repo="$("$here/thimble-app-dir" 2>/dev/null)" || { printf '{"ok": false, "error": {"code": "NO_VENV", "message": "thimble cannot find its install", "fix": "run thimble doctor"}}\n'; exit 0; }
    export THIMBLE_CALLER_CWD="${THIMBLE_CALLER_CWD:-$PWD}" THIMBLE_PLUGIN_ROOT="$plugin"
    cd "$repo/backend"
    exec "$here/thimble-python" -m app.activate "$@";;
  open)
    # 0.9.0: the press that opens the browser workbench on an object (backend/app/open_cmd.py); JSON on stdout, exit 0
    repo="$("$here/thimble-app-dir" 2>/dev/null)" || { printf '{"ok": false, "error": {"code": "START", "message": "thimble cannot find its install", "fix": "run thimble doctor"}}\n'; exit 0; }
    export THIMBLE_CALLER_CWD="${THIMBLE_CALLER_CWD:-$PWD}" THIMBLE_PLUGIN_ROOT="$plugin"
    cd "$repo/backend"
    shift  # open_cmd's own options follow; the word `open` is this case's
    exec "$here/thimble-python" -m app.open_cmd "$@";;
  state | act | view)
    # the terminal UI reads a surface and acts as the browser would, through thimble's backend in this process
    # (backend/app/local.py), which opens no port; on failure it prints {"error": …} and exits 1, as local.py does.
    # `view host` serves the views the terminal UI draws (backend/app/term_views.py) and `view text` draws one as text
    repo="$("$here/thimble-app-dir" 2>/dev/null)" || { printf '{"error": "thimble cannot find its install"}\n'; exit 1; }
    export THIMBLE_CALLER_CWD="${THIMBLE_CALLER_CWD:-$PWD}" THIMBLE_PLUGIN_ROOT="$plugin"
    cd "$repo/backend"
    exec "$here/thimble-python" -m app.local "$@";;
  *)
    if [[ "$SUPERVISOR_COMMANDS" == *" $1 "* ]]; then
      if [ "$1" = prompt ] && rendered_prompts "${@:2}"; then exit 0; fi
      # `prompt main --if-active --session <sid>`, the SessionStart hook's, prints only for a session thimble is on in:
      # without its marker it exits here, before Python starts (a coding session's /clear and /compact)
      if [ "$1" = prompt ]; then
        active=0 sid_arg="" prev=""
        for a in "$@"; do
          case "$prev" in --session) sid_arg="$a";; esac
          case "$a" in --if-active) active=1;; --session=*) sid_arg="${a#--session=}";; esac
          prev="$a"
        done
        sid_arg="${sid_arg:-${CLAUDE_CODE_SESSION_ID:-}}"
        if [ "$active" = 1 ] && { [ -z "$sid_arg" ] || [ ! -e "${THIMBLE_HOME:-$HOME/.thimble}/up/$sid_arg.active" ]; }; then exit 0; fi
      fi
      # `server up` and `prompt` are run by the skills, each as a single command, so that one sandbox.excludedCommands
      # entry or allowed-tools rule covers it (Claude Code checks each part of a compound command); a skill fails on a
      # non-zero exit, so each always exits 0, with a thimble: line when the tree cannot be found. `prompt` leaves its
      # stderr apart, since the SessionStart hook prints its stdout into the model's context (the skills add 2>&1)
      up=0 skill=0
      case "$1 ${2:-}" in "server up"* | "server ensure"* | "up "* | "ensure "*) up=1 skill=1;; prompt*) skill=1;; esac
      # /thimble feedback: the report, with the folder the skill names, and no server; not when the plugin's hook wrote
      # it already and left what it printed for the supervisor to print (app/cli.py hook_up)
      if [ "$up" = 1 ]; then
        fb=0 cwd_arg="" sid_arg="" prev=""
        for a in "$@"; do
          case "$prev" in --action) [ "$a" != feedback ] || fb=1;; --cwd) cwd_arg="$a";; --session) sid_arg="$a";; esac
          case "$a" in --action=feedback) fb=1;; --cwd=*) cwd_arg="${a#--cwd=}";; --session=*) sid_arg="${a#--session=}";; esac
          prev="$a"
        done
        if [ "$fb" = 1 ] && ! { [ -n "$sid_arg" ] && [ -f "${THIMBLE_HOME:-$HOME/.thimble}/up/$sid_arg.json" ]; }; then
          [ -z "$cwd_arg" ] || export THIMBLE_CALLER_CWD="$cwd_arg"
          feedback --skill
        fi
      fi
      # the tree (backend/ and its .venv) is found by bin/thimble-app-dir: `../..` in a checkout or an unzipped release,
      # the installed tree named in $THIMBLE_HOME/app-dir when this copy sits in Claude Code's plugin cache.
      # THIMBLE_PLUGIN_ROOT names this plugin copy, whose hooks and watcher /thimble looks for (cli.plugin_root)
      repo="$("$here/thimble-app-dir" 2>&1)" || {
        [ "$skill" = 1 ] || { printf '%s\n' "$repo" >&2; exit 1; }
        if [ "$up" = 1 ]; then printf '%s\n' "$repo"; else printf '%s\n' "$repo" >&2; fi
        exit 0; }
      export THIMBLE_CALLER_CWD="${THIMBLE_CALLER_CWD:-$PWD}" THIMBLE_PLUGIN_ROOT="$plugin"
      cd "$repo/backend"
      if [ "$up" = 1 ]; then "$here/thimble-python" -m app.cli "$@" 2>&1 || true; exit 0; fi
      if [ "$skill" = 1 ]; then "$here/thimble-python" -m app.cli "$@" || true; exit 0; fi
      exec "$here/thimble-python" -m app.cli "$@"
    fi
    printf 'thimble: unknown command %s\n' "$1" >&2
    usage >&2
    exit 2;;
esac

# The session: `claude` itself in this folder. Every Claude Code session loads thimble's plugin and turns thimble on at
# its first data read; this command also opens the browser workbench at the session's start. It exports THIMBLE_OPEN=1,
# which the terminal UI reads at session.start: it turns thimble on there (via launcher) and presses home, which starts
# thimble's server and opens the browser signed in (`thimble open`). Where Claude Code will not load thimble's hooks
# module (managed settings, disableAllHooks), no terminal UI runs, so the first prompt is `/thimble browser` instead, whose
# skill hook opens the browser. The plugin is loaded with --plugin-dir only when Claude Code has not installed this
# install's copy. CLAUDE_CODE_TERMINAL_MCP_TOOLS names the tools after which a turn needs no closing words
# (backend/app/terminal_tools.py), when this `claude` reads it.
# Those values come from `launch-args` (backend/app/cli.py launch_args), which keeps them in $THIMBLE_HOME/launcher.json
# under a key of the files they depend on (KEY_PY: this plugin and tree, Claude Code's plugin registry and settings, the
# managed settings, the `claude` executable); a launch whose files did not change reads them there with one python3 -I
# -S and starts no backend Python, so `claude` starts within a few hundredths of a second.
# thimble talks to its own server on 127.0.0.1. Keep that traffic off any HTTP proxy the shell sets: every process of the
# session (Claude Code, its hooks module, the MCP shim, the server a press starts) reads NO_PROXY / no_proxy. Only here:
# a subcommand runs Python, whose app/config.py adds the same for itself and its children and keeps the shell's values
# for /thimble's proxy line (cli.proxy_unsafe), which this edit would hide.
for _np in NO_PROXY no_proxy; do
  case ",${!_np:-}," in
    *,127.0.0.1,*) ;;
    *) export "$_np=${!_np:+${!_np},}127.0.0.1,localhost" ;;
  esac
done
unset _np
command -v claude >/dev/null 2>&1 || {
  printf 'thimble: the `claude` CLI is not on PATH. thimble runs inside Claude Code: install it (https://docs.anthropic.com/en/docs/claude-code), then run thimble again.\n' >&2
  exit 1; }
# every flag goes to `claude` as it is, but --new (0.8.0's, now the default); --settings and --safe-mode also say whether
# the hooks module loads
args=() own="" safe=0
for a in "$@"; do
  case "$a" in
    --new) continue;;
    --safe-mode) safe=1;;
  esac
  args+=("$a")
done
for i in "${!args[@]}"; do
  case "${args[$i]}" in
    --settings) own="${args[$((i + 1))]:-}";;
    --settings=*) own="${args[$i]#--settings=}";;
  esac
done
repo="$("$here/thimble-app-dir")"
cwd="$PWD"
home="${THIMBLE_HOME:-$HOME/.thimble}"
# KEY_PY PLUGIN REPO CWD HOME [EXTRA…]: the key of what launch-args' values depend on, then, when launcher.json holds
# them under that key, the values (exit 0); else the key alone (exit 3). Standard library only, under -I -S.
KEY_PY='import hashlib, json, os, sys
plugin, repo, cwd, home = sys.argv[1:5]
cfg = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
def st(p):
    try:
        s = os.stat(p)
        return "%d:%d" % (s.st_mtime_ns, s.st_size)
    except OSError:
        return "-"
def which(name):
    for d in os.environ.get("PATH", "").split(os.pathsep):
        p = os.path.join(d or ".", name)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return os.path.realpath(p)
    return ""
claude = os.environ.get("THIMBLE_CLAUDE_BIN") or which("claude")
managed = ["/etc/claude-code", "/Library/Application Support/ClaudeCode"]
paths = [os.path.join(plugin, ".claude-plugin", "plugin.json"), os.path.join(repo, "backend", "app", "tools.py"),
         os.path.join(repo, "prompts", "tools.md"), os.path.join(cfg, "plugins", "installed_plugins.json"),
         os.path.join(cfg, "plugins", "known_marketplaces.json"), os.path.join(cfg, "settings.json"),
         os.path.join(cfg, "remote-settings.json"), os.path.join(cwd, ".claude", "settings.json"),
         os.path.join(cwd, ".claude", "settings.local.json"), os.path.join(home, "terminal-tools.json"), claude,
         *(os.path.join(m, n) for m in managed for n in ("managed-settings.json", "managed-settings.d"))]
envs = [os.environ.get(k, "") for k in ("CLAUDE_CODE_TERMINAL_MCP_TOOLS", "THIMBLE_NO_MODULE", "CLAUDE_CODE_SAFE_MODE")]
key = hashlib.sha256("\0".join([plugin, repo, cwd, claude, *map(st, paths), *envs, *sys.argv[5:]]).encode()).hexdigest()[:32]
try:
    rec = json.load(open(os.path.join(home, "launcher.json"), encoding="utf-8")).get(key)
except (OSError, ValueError, AttributeError):
    rec = None
print(key)
if not isinstance(rec, dict):
    sys.exit(3)
for k in ("load", "turn_tools", "modules_off"):
    print(" ".join(str(rec.get(k) or "").split()))
print("\t".join(" ".join(str(n).split()) for n in rec.get("notes") or []))'
py=python3
command -v python3 >/dev/null 2>&1 || py="$repo/backend/.venv/bin/python"
rc=0
out="$("$py" -I -S -c "$KEY_PY" "$plugin" "$repo" "$cwd" "$home" "$own" "$safe")" || rc=$?
key="${out%%$'\n'*}"
if [ "$rc" != 0 ]; then
  la=(--cwd "$cwd" --key "$key")
  [ -z "$own" ] || la+=(--settings "$own")
  [ "$safe" = 0 ] || la+=(--safe-mode)
  out="$key"$'\n'"$(cd "$repo/backend" && THIMBLE_CALLER_CWD="$cwd" "$here/thimble-python" -m app.cli launch-args "${la[@]}")" || {
    printf 'thimble: could not find what the session starts with (see the lines above); run `thimble doctor`\n' >&2; exit 1; }
fi
# one value per line (a command substitution drops the empty lines at the end, which read leaves empty)
{ IFS= read -r key; IFS= read -r load; IFS= read -r turn_tools; IFS= read -r modules_off; IFS= read -r notes; } <<<"$out" || true
if [ -n "$notes" ]; then
  IFS=$'\t' read -r -a note_lines <<<"$notes"
  for n in "${note_lines[@]}"; do printf '%s\n' "$n" >&2; done
fi
pre=()
[ -z "$load" ] || pre=(--plugin-dir "$load")
first=()
[ -z "$modules_off" ] || first=(-- /thimble browser)
export THIMBLE_OPEN=1
[ -z "$turn_tools" ] || export CLAUDE_CODE_TERMINAL_MCP_TOOLS="$turn_tools"
exec claude ${pre[@]+"${pre[@]}"} ${args[@]+"${args[@]}"} ${first[@]+"${first[@]}"}
