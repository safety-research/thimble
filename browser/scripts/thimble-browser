#!/usr/bin/env bash
# thimble-browser: starts thimble's browser workbench (thimble 0.8's browser mode) on a folder of files. scripts/install.sh,
# at the top of the repository, installs what it needs and puts a launcher for it on PATH. Here it builds the page again
# when its sources are newer than the build, then runs the workbench's own launcher (plugin/bin/thimble), which starts
# the server and a Claude Code session in this terminal with the workbench's plugin (plugin/) loaded; the page shows that
# session's chat, its cards, the files, the labels and the report.
#
#   thimble-browser [FOLDER] [--port N] [claude flags...]   FOLDER: the folder you are in when not given
#
# The workbench keeps its workspaces in ~/.thimble-browser, or in THIMBLE_BROWSER_HOME, apart from the terminal
# plugin's ~/.thimble. The server listens on 127.0.0.1, on port 8300 or the next free one (--port N takes N alone).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

folder="" args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --port) [ $# -ge 2 ] || { echo "thimble-browser: --port needs a number" >&2; exit 2; }; export THIMBLE_PORT="$2"; shift 2 ;;
    --port=*) export THIMBLE_PORT="${1#--port=}"; shift ;;
    -h | --help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) args+=("$1"); shift ;;
    *) if [ -z "$folder" ] && [ -d "$1" ]; then folder="$1"; else args+=("$1"); fi; shift ;;
  esac
done
[ -z "$folder" ] || cd "$folder"

export THIMBLE_HOME="${THIMBLE_BROWSER_HOME:-$HOME/.thimble-browser}"
mkdir -p "$THIMBLE_HOME"

[ -x "$root/backend/.venv/bin/python" ] || {
  echo "thimble-browser: $root/backend/.venv is missing: run scripts/install.sh at the top of the repository" >&2; exit 1; }

# the page is built the first time, and again when its sources are newer than the build (after a pull, say)
fe="$root/frontend"
if [ ! -f "$fe/dist/index.html" ] || [ -n "$(find "$fe/src" "$fe/index.html" "$fe/package-lock.json" \
     -newer "$fe/dist/index.html" -print -quit 2>/dev/null)" ]; then
  echo "thimble-browser: building the page..."
  [ -d "$fe/node_modules" ] || npm --prefix "$fe" ci --no-audit --no-fund
  npm --prefix "$fe" run build >/dev/null
fi
exec "$root/plugin/bin/thimble" ${args[@]+"${args[@]}"}
