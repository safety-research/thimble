#!/usr/bin/env bash
# thimble-browser: starts thimble's browser workbench on a folder of files. thimble's
# install (scripts/install.sh) builds it in ~/.thimble/fixes/live/browser and puts a launcher for it on PATH. Here it
# builds the page again when its sources are newer than the build, then starts the server on 127.0.0.1, opens the folder
# as a workspace and prints the page's sign-in link (backend app/cli.py `browser`). The server runs the chat and
# thimble's agents itself, on the way to reach Claude chosen at install or in the page: your Claude Code sign-in, an
# Anthropic API key, or Workload Identity Federation. Ctrl-C stops the server. Each start is a new session, as in Claude
# Code: an empty chat, canvas, report and labels, as at the folder's first start. --continue and --resume bring an
# earlier session back whole.
#
#   thimble-browser [FOLDER] [--port N]   FOLDER: the folder you are in when not given; starts a new session
#   thimble-browser -c | --continue       continue the folder's latest session: its chat, canvas, report and labels
#   thimble-browser -r | --resume [ID]    pick an earlier session from a list (or the session of chat ID)
#   thimble-browser --setup               choose how the workbench reaches Claude, and check it
#   thimble-browser --unpair              sign every browser out and change the sign-in link
#   thimble-browser --setup --how claude-code | --how api-key | --how wif --wif-file F   the same, without asking
#
# The workbench keeps its workspaces and its choice in ~/.thimble-browser, or in THIMBLE_BROWSER_HOME, apart from the
# terminal plugin's ~/.thimble. The server listens on 127.0.0.1, on port 8300 or the next free one (--port N takes N alone).
# A workbench installed elsewhere (before 0.10.8) runs from ~/.thimble/fixes/live once `thimble update` has put it
# there (the newest release with your fixes), and from then on the launcher on PATH starts it there.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

fixes="${THIMBLE_HOME:-$HOME/.thimble}/fixes"
if [ -z "${THIMBLE_BROWSER_LIVE:-}" ] && [ -f "$fixes/browser-ready" ] && [ -x "$fixes/live/browser/scripts/thimble-browser" ] \
   && [ "$(cd "$fixes/live/browser" && pwd -P)" != "$root" ]; then
  export THIMBLE_BROWSER_LIVE=1
  shown="$fixes"
  case "$fixes" in "$HOME"/*) shown="~/${fixes#"$HOME"/}" ;; esac
  echo "thimble-browser: from $shown/live, the release thimble update installed, with your fixes" >&2
  exec "$fixes/live/browser/scripts/thimble-browser" "$@"
fi

folder="" setup=0 setup_args=() session=new
while [ $# -gt 0 ]; do
  case "$1" in
    -c | --continue) session=continue; shift ;;
    -r | --resume)
      session=pick; shift
      # an id, not a folder, takes the place of the list
      if [ $# -gt 0 ] && [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*$ ]] && [ ! -d "$1" ]; then session="$1"; shift; fi ;;
    --resume=*) session="${1#--resume=}"; shift ;;
    --port) [ $# -ge 2 ] || { echo "thimble-browser: --port needs a number" >&2; exit 2; }; export THIMBLE_PORT="$2"; shift 2 ;;
    --port=*) export THIMBLE_PORT="${1#--port=}"; shift ;;
    --setup) setup=1; shift; setup_args=("$@"); break ;;
    --unpair) setup=unpair; shift ;;
    -h | --help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "thimble-browser: unknown option $1 (see --help)" >&2; exit 2 ;;
    *) if [ -z "$folder" ] && [ -d "$1" ]; then folder="$1"; else echo "thimble-browser: $1 is not a folder" >&2; exit 2; fi; shift ;;
  esac
done

export THIMBLE_HOME="${THIMBLE_BROWSER_HOME:-$HOME/.thimble-browser}"
mkdir -p "$THIMBLE_HOME" && chmod 700 "$THIMBLE_HOME"
# the workspaces (cards, chats, reports) live in the home too, not in this checkout
export THIMBLE_WORKSPACES_DIR="${THIMBLE_WORKSPACES_DIR:-$THIMBLE_HOME/workspaces}"
py="$root/backend/.venv/bin/python"
[ -x "$py" ] || {
  echo "thimble-browser: $root/backend/.venv is missing, so the workbench is not installed here: run thimble's" \
    "install again (INSTALL.md)" >&2
  exit 1; }

if [ "$setup" = 1 ]; then
  cd "$root/backend" && exec "$py" -m app.claude_access setup ${setup_args[@]+"${setup_args[@]}"}
fi
if [ "$setup" = unpair ]; then
  cd "$root/backend" && exec "$py" -m app.cli unpair
fi

# quietly CMD...: runs CMD, and shows what it printed only when it fails (as scripts/install.sh does)
quietly() {
  local log
  log="$(mktemp)"
  if "$@" >"$log" 2>&1; then rm -f "$log"; else cat "$log" >&2; rm -f "$log"; return 1; fi
}

# the server's packages are compiled to bytecode once, by the command the install runs (browser_packages in
# plugin/engine/kernel/fixes.py, which leaves thimble-compiled in .venv). A card's kernel writes no bytecode, so without
# it each kernel's start compiles pandas and ipykernel again. An install or update by thimble 0.10.12 or before did not
# compile them
if [ ! -f "$root/backend/.venv/thimble-compiled" ]; then
  echo "thimble-browser: compiling the server's packages, once..."
  if quietly uv sync --project "$root/backend" --python ">=3.12,<3.15" --frozen --no-dev --no-install-project --extra dev --compile-bytecode
  then
    : > "$root/backend/.venv/thimble-compiled"
  else
    echo "thimble-browser: the server's packages are not compiled, so each kernel's start compiles them: after you" \
      "fix that, start thimble-browser again" >&2
  fi
fi

# the headless Chromium the workbench draws cards in: where no Chrome, Edge or Chromium of the system's is found,
# Playwright's own, which the install and thimble update fetch (backend app/headless.py). An install or update by
# thimble 0.10.12 or before fetched none, and its server only logs that cards are not checked. The workbench's own check
# downloads what is missing, once, and says so on one line; a download that fails says why and the command that fetches
# it, and the server starts all the same
(cd "$root/backend" && "$py" -m app.headless --start) || true

# run from live, its kernel is live's too
live_kernel=
if [ "$(cd "$fixes/live/browser" 2>/dev/null && pwd -P)" = "$root" ] && [ -x "$fixes/live/plugin/bin/thimble" ]; then
  live_kernel="$fixes/live/plugin/bin/thimble"
fi

# run from live: the launcher on PATH that an install before 0.10.8 wrote starts the workbench of the folder it
# installed from, whose script hands it to live (above). It starts live's from now on, as the install writes it, so that
# the folder can go (thimble install launcher, which says nothing unless it fails). A dev install's launcher
# (scripts/install.sh --local) starts its clone on purpose, and stays
if [ -n "$live_kernel" ] && ! grep -q '"kind": "clone"' "$fixes/release.json" 2>/dev/null; then
  on_path="$(command -v thimble-browser 2>/dev/null || true)"
  if [ -f "$on_path" ] && [ ! -L "$on_path" ] && grep -q 'written by thimble scripts/install.sh' "$on_path" 2>/dev/null &&
     ! grep -qF -e "$root/scripts/thimble-browser" -e "$fixes/live/browser/scripts/thimble-browser" "$on_path"; then
    THIMBLE_HOME="${fixes%/fixes}" "$live_kernel" install launcher --bin-dir "$(dirname "$on_path")" || true
  fi
fi

# run from live: the fixes an update by thimble 0.10.5 or before set aside, and those an update by 0.10.6 put back with
# no check (release.json's checked is not its base), are checked on this release, as at a fix's end, and those that
# fit are on before the page is built (thimble fix carry, once, which says what came of them); a carry that fails
# leaves them off, and the workbench starts all the same
due=
if [ -f "$fixes/pending/current.json" ] && ! grep -q '"carried": true' "$fixes/pending/current.json"; then due=1; fi
if [ -f "$fixes/release.json" ]; then
  base=$(sed -n 's/^ *"base": *"\([0-9a-f]*\)".*/\1/p' "$fixes/release.json" || true)
  checked=$(sed -n 's/^ *"checked": *"\([0-9a-f]*\)".*/\1/p' "$fixes/release.json" || true)
  if [ -n "$base" ] && [ "$base" != "$checked" ]; then due=1; fi
fi
if [ -n "$live_kernel" ] && [ -n "$due" ]; then
  THIMBLE_HOME="${fixes%/fixes}" "$live_kernel" fix carry || true
fi

# the page is built the first time, and again when its sources are newer than the build (after a pull, say); what npm
# and Vite print (a chunk size warning, npm's update notice) shows only when the build fails, so the link stays in view
fe="$root/frontend"
if [ ! -f "$fe/dist/index.html" ] || [ -n "$(find "$fe/src" "$fe/index.html" "$fe/package-lock.json" \
     -newer "$fe/dist/index.html" -print -quit 2>/dev/null)" ]; then
  echo "thimble-browser: building the page..."
  export NPM_CONFIG_UPDATE_NOTIFIER=false
  [ -d "$fe/node_modules" ] || quietly npm --prefix "$fe" ci --no-audit --no-fund
  quietly npm --prefix "$fe" run build
fi
here="$(cd "${folder:-.}" && pwd -P)"
cd "$root/backend"
exec "$py" -m app.cli browser --cwd "$here" --session "$session"
