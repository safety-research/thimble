#!/bin/sh
# Refuses a commit message with a Claude-Session: line or a link to a Claude Code session, which is private.
# Turn it on with `git config core.hooksPath scripts/hooks`; `git commit --no-verify` commits anyway.
hits=$(sed -e '/^# -* >8 -*$/,$d' -e '/^#/d' "$1" | grep -Ei '^[[:space:]]*claude-session:|claude\.ai/code/session_')
[ -z "$hits" ] && exit 0
echo "commit-msg: this message links a Claude Code session, which is private:" >&2
echo "$hits" >&2
echo "Remove the line, or commit with --no-verify to keep it." >&2
exit 1
