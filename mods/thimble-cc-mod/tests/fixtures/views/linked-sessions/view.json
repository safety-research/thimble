{
  "version": 1,
  "name": "Linked sessions",
  "slug": "linked-sessions",
  "description": "Runs of agent teams read as their sessions on one clock: a lane per session with each subagent under the session that spawned it, every tool call a mark coloured by its tool or by the labels, and a session's prompts and calls beside the lanes.",
  "scope": ["runs/*.jsonl", "runs/*/sessions-index.json"],
  "collections": [
    {
      "name": "runs",
      "one": "one run's folder of sessions",
      "key": "id",
      "title": "title",
      "fields": [
        {"name": "id", "type": "text"},
        {"name": "ref", "type": "ref"},
        {"name": "title", "type": "text"},
        {"name": "team", "type": "category"},
        {"name": "started", "type": "time", "derived": "cleaned", "from": "the run's first line", "how": "in UTC"},
        {"name": "span", "type": "duration", "derived": "computed", "from": "its sessions' times", "how": "seconds from its first line to its last"},
        {"name": "sessions", "type": "number"}
      ],
      "detail": {
        "fields": ["team", "started", "span", "sessions"],
        "related": [{"title": "Sessions", "collection": "sessions", "via": "run", "show": {"kind": "table", "columns": [{"field": "name"}, {"field": "depth"}, {"field": "start"}, {"field": "end"}, {"field": "calls", "show": "bar"}], "sort": {"field": "start"}}}]
      }
    },
    {
      "name": "sessions",
      "one": "one transcript, a lead's or a subagent's",
      "key": "id",
      "title": "name",
      "fields": [
        {"name": "id", "type": "text"},
        {"name": "ref", "type": "ref"},
        {"name": "name", "type": "text", "derived": "computed", "from": "agent and run", "how": "the agent's name and its run"},
        {"name": "agent", "type": "category", "derived": "computed", "from": "a Task call's subagent_type, else the run's index", "how": "the subagent's type, else the index's name, else lead"},
        {"name": "run", "type": "category", "link": "runs"},
        {"name": "parent", "type": "text", "link": "sessions", "derived": "computed", "from": "the Task call that names its agentId or gave its prompt", "how": "the session that spawned it"},
        {"name": "depth", "type": "number", "derived": "computed", "from": "parent", "how": "sessions above it in its run's tree"},
        {"name": "start", "type": "duration", "derived": "cleaned", "from": "its first line's timestamp", "how": "seconds since the run's first line"},
        {"name": "end", "type": "duration", "derived": "cleaned", "from": "its last line's timestamp", "how": "seconds since the run's first line"},
        {"name": "calls", "type": "number"},
        {"name": "team", "type": "category"}
      ],
      "detail": {
        "meta": ["agent", "run"],
        "fields": ["parent", "depth", "start", "end", "calls"],
        "related": [
          {"title": "Prompts and texts", "collection": "messages", "via": "session", "show": {"kind": "transcript", "speaker": "kind", "text": "text", "time": "time"}},
          {"title": "Calls", "collection": "calls", "via": "session", "show": {"kind": "transcript", "speaker": "tool", "text": "input", "time": "time"}}
        ]
      }
    },
    {
      "name": "calls",
      "one": "one tool call, its tool_use line and its tool_result line",
      "key": "id",
      "title": "title",
      "fields": [
        {"name": "id", "type": "text"},
        {"name": "ref", "type": "ref"},
        {"name": "title", "type": "text", "derived": "computed", "from": "the tool's name and input", "how": "the tool and the start of its input"},
        {"name": "session", "type": "text", "link": "sessions"},
        {"name": "run", "type": "category", "link": "runs"},
        {"name": "time", "type": "duration", "derived": "cleaned", "from": "timestamp", "how": "seconds since the run's first line"},
        {"name": "duration", "type": "duration", "derived": "computed", "from": "the tool_use and tool_result timestamps", "how": "seconds between them"},
        {"name": "tool", "type": "category", "derived": "cleaned", "from": "a tool_use block's name", "how": "Agent read as Task"},
        {"name": "outcome", "type": "category", "derived": "computed", "from": "is_error or isError, and the result's text", "how": "denied when the text says so, error when flagged, else ok"},
        {"name": "duration band", "type": "category", "derived": "computed", "from": "duration", "how": "under 1 s, 1–10 s or over 10 s"},
        {"name": "file type", "type": "category", "derived": "computed", "from": "files", "how": "the first file's extension, test files apart"},
        {"name": "input", "type": "text"},
        {"name": "files", "type": "list", "derived": "computed", "from": "file_path, or a Bash command and its result", "how": "the paths named in them"},
        {"name": "child", "type": "text", "link": "sessions", "derived": "computed", "from": "the Task result's agentId, else the prompt a session got", "how": "the session the Task call spawned"}
      ],
      "detail": {
        "meta": ["tool", "outcome", "duration band"],
        "fields": ["session", "run", "time", "duration", "child", "files"],
        "text": "input"
      }
    },
    {
      "name": "messages",
      "one": "one prompt or text of a session",
      "key": "ref",
      "title": "text",
      "fields": [
        {"name": "ref", "type": "ref"},
        {"name": "session", "type": "text", "link": "sessions"},
        {"name": "time", "type": "duration", "derived": "cleaned", "from": "timestamp", "how": "seconds since the run's first line"},
        {"name": "kind", "type": "category", "derived": "computed", "from": "the message's type and place", "how": "prompt, result for a session's last text, else text"},
        {"name": "text", "type": "text"}
      ]
    }
  ],
  "stats": [
    {"label": "runs", "collection": "runs", "agg": "count"},
    {"label": "sessions", "collection": "sessions", "agg": "count"},
    {"label": "calls", "collection": "calls", "agg": "count"}
  ],
  "tabs": [
    {
      "name": "Sessions",
      "collection": "calls",
      "overview": {"kind": "histogram", "time": "time", "color": "tool"},
      "zoom": "a click on the strip narrows the lanes to that time",
      "filter": {"fields": ["run", "tool", "outcome"]},
      "body": [{"kind": "lanes", "lane": "session", "time": "time", "color": "tool", "lanes": {"collection": "sessions", "label": "name", "start": "start", "end": "end", "parent": "parent"}}]
    },
    {
      "name": "Calls",
      "collection": "calls",
      "overview": {"kind": "bars", "field": "tool"},
      "zoom": "a click on a tool keeps its calls",
      "filter": {"fields": ["tool", "outcome", "duration band"], "search": ["title", "input", "files"]},
      "body": [
        {"kind": "bars", "field": "tool"},
        {"kind": "table", "columns": [{"field": "time"}, {"field": "session"}, {"field": "tool"}, {"field": "input"}, {"field": "duration", "show": "bar"}, {"field": "outcome"}], "sort": {"field": "time"}}
      ]
    },
    {
      "name": "Team",
      "collection": "sessions",
      "overview": {"kind": "bars", "field": "run"},
      "zoom": "a click on a run keeps its sessions",
      "filter": {"fields": ["run"]},
      "body": [{"kind": "graph", "edge": "parent", "label": "name", "meta": ["calls", "start", "end"]}]
    }
  ],
  "accepts": [{"form": "L<n>", "means": "the call or message on line <n>, selected in its session"}],
  "units": [{"form": "<run>", "means": "one run, its facet chosen"}, {"form": "<session>", "means": "one session, selected"}]
}
