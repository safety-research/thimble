{
  "version": 1,
  "name": "Repository",
  "slug": "repository",
  "description": "Several agent runs on one small library, read as a code forge shows them: pull requests, issues, discussions and agents in tabs filtered on every field, and a pull request's whole story with its commits, reviews and comments.",
  "scope": ["runs/*.json", "runs/*.jsonl", "runs/*.csv"],
  "collections": [
    {
      "name": "runs",
      "one": "one run's folder",
      "key": "id",
      "title": "id",
      "fields": [
        {"name": "id", "type": "text"},
        {"name": "ref", "type": "ref"},
        {"name": "title", "type": "text"},
        {"name": "approvals", "type": "number", "derived": "cleaned", "from": "approvals, required_approvals or policy.approvals", "how": "the first number in free text"},
        {"name": "team", "type": "number"}
      ],
      "detail": {
        "fields": ["approvals", "team"],
        "related": [{"title": "Pull requests", "collection": "pulls", "via": "run", "show": {"kind": "table", "columns": [{"field": "number"}, {"field": "title"}, {"field": "state"}], "sort": {"field": "number"}}}]
      }
    },
    {
      "name": "pulls",
      "one": "one pull request of a run, with its records",
      "key": "key",
      "title": "title",
      "fields": [
        {"name": "key", "type": "text"},
        {"name": "ref", "type": "ref"},
        {"name": "run", "type": "category", "link": "runs"},
        {"name": "number", "type": "number", "label": "#"},
        {"name": "title", "type": "text"},
        {"name": "author", "type": "category", "link": "agents"},
        {"name": "state", "type": "category", "derived": "computed", "from": "its merge, close and reopen records", "how": "open, merged or closed"},
        {"name": "area", "type": "category", "derived": "computed", "from": "labels or area, else the issue it fixes", "how": "the first label, else the issue's area"},
        {"name": "closes", "type": "text", "link": "issues", "derived": "cleaned", "from": "fixes, closes or linked_issue", "how": "the first number in free text"},
        {"name": "to_merge", "type": "duration", "label": "to merge", "derived": "computed", "from": "its opening and its merge", "how": "time between them"},
        {"name": "first_review", "type": "duration", "label": "first review", "derived": "computed", "from": "its opening and its first review", "how": "time between them"},
        {"name": "flags", "type": "list", "derived": "computed", "from": "its merge, reviews and pushes", "how": "merged by its author, merged over a change request, pushed after its last approval, or waiting for approvals"}
      ],
      "detail": {
        "meta": ["state", "area", "run"],
        "fields": ["author", "closes", "to_merge", "first_review", "flags"],
        "related": [{"title": "Story", "collection": "events", "via": "unit", "show": {"kind": "transcript", "speaker": "author", "text": "text", "time": "at"}}]
      }
    },
    {
      "name": "issues",
      "one": "one issue of a run, with its records",
      "key": "key",
      "title": "title",
      "fields": [
        {"name": "key", "type": "text"},
        {"name": "ref", "type": "ref"},
        {"name": "run", "type": "category", "link": "runs"},
        {"name": "number", "type": "number", "label": "#"},
        {"name": "title", "type": "text"},
        {"name": "author", "type": "category"},
        {"name": "state", "type": "category", "derived": "computed", "from": "its close records and the pull requests that fix it", "how": "fixed once a pull request that fixes it merged"},
        {"name": "area", "type": "category"},
        {"name": "origin", "type": "category", "derived": "computed", "from": "its opening and the run's start", "how": "backlog when opened before the run started, else found during the run"},
        {"name": "fixed_by", "type": "text", "label": "fixed by", "link": "pulls", "derived": "computed", "from": "the pull requests' closes", "how": "the merged pull request that fixes it"},
        {"name": "to_fix", "type": "duration", "label": "to fix", "derived": "computed", "from": "its opening and the merge that fixed it", "how": "time between them"}
      ],
      "detail": {
        "meta": ["state", "area", "origin", "run"],
        "fields": ["author", "fixed_by", "to_fix"],
        "related": [
          {"title": "Story", "collection": "events", "via": "unit", "show": {"kind": "transcript", "speaker": "author", "text": "text", "time": "at"}},
          {"title": "Pull requests", "collection": "pulls", "via": "closes", "show": {"kind": "list", "meta": ["state", "author"]}}
        ]
      }
    },
    {
      "name": "discussions",
      "one": "one thread of the board",
      "key": "key",
      "title": "title",
      "fields": [
        {"name": "key", "type": "text"},
        {"name": "ref", "type": "ref"},
        {"name": "run", "type": "category", "link": "runs"},
        {"name": "number", "type": "number", "label": "#"},
        {"name": "title", "type": "text"},
        {"name": "author", "type": "category"},
        {"name": "posts", "type": "number"},
        {"name": "posters", "type": "list"}
      ],
      "detail": {
        "meta": ["run", "author"],
        "fields": ["posts", "posters"],
        "related": [{"title": "Posts", "collection": "events", "via": "unit", "show": {"kind": "transcript", "speaker": "author", "text": "text", "time": "at"}}]
      }
    },
    {
      "name": "agents",
      "one": "one agent of a run",
      "key": "key",
      "title": "name",
      "fields": [
        {"name": "key", "type": "text"},
        {"name": "ref", "type": "ref"},
        {"name": "run", "type": "category", "link": "runs"},
        {"name": "name", "type": "text"},
        {"name": "opened", "type": "number"},
        {"name": "merged", "type": "number"},
        {"name": "approved", "type": "number"},
        {"name": "changes", "type": "number", "label": "changes asked"},
        {"name": "comments", "type": "number"},
        {"name": "posts", "type": "number"}
      ],
      "detail": {
        "meta": ["run"],
        "fields": ["opened", "merged", "approved", "changes", "comments", "posts"],
        "related": [{"title": "Pull requests", "collection": "pulls", "via": "author", "show": {"kind": "list", "meta": ["state", "area"]}}]
      }
    },
    {
      "name": "events",
      "one": "one opening, push, review, comment, merge, close, reopen, post or sign-off",
      "key": "key",
      "title": "text",
      "fields": [
        {"name": "key", "type": "text"},
        {"name": "ref", "type": "ref"},
        {"name": "unit", "type": "text", "link": ["pulls", "issues", "discussions"]},
        {"name": "run", "type": "category", "link": "runs"},
        {"name": "at", "type": "duration", "derived": "cleaned", "from": "ts, time, created_at, committed_at or submitted_at", "how": "time since the run started"},
        {"name": "action", "type": "category", "derived": "cleaned", "from": "kind, and a review's verdict", "how": "opened, pushed, merged and so on, a review by its verdict"},
        {"name": "author", "type": "category"},
        {"name": "kind", "type": "category", "derived": "cleaned", "from": "type or event, else the export table", "how": "push read as commit, pr.merged as merge and so on"},
        {"name": "text", "type": "text"}
      ]
    }
  ],
  "stats": [
    {"label": "runs", "collection": "runs", "agg": "count"},
    {"label": "pull requests", "collection": "pulls", "agg": "count"},
    {"label": "merged", "collection": "pulls", "agg": "count", "where": {"field": "state", "is": "merged"}},
    {"label": "issues", "collection": "issues", "agg": "count"}
  ],
  "tabs": [
    {
      "name": "Pull requests",
      "collection": "pulls",
      "overview": {"kind": "bars", "field": "state"},
      "zoom": "a click on a state keeps its pull requests",
      "filter": {"fields": ["run", "state", "area", "flags"]},
      "body": [{"kind": "table", "columns": [{"field": "run"}, {"field": "number"}, {"field": "title"}, {"field": "author"}, {"field": "state"}, {"field": "to_merge", "show": "bar"}, {"field": "flags", "show": "chips"}], "sort": {"field": "number"}}]
    },
    {
      "name": "Issues",
      "collection": "issues",
      "overview": {"kind": "bars", "field": "state"},
      "zoom": "a click on a state keeps its issues",
      "filter": {"fields": ["run", "state", "origin", "area"]},
      "body": [{"kind": "table", "columns": [{"field": "run"}, {"field": "number"}, {"field": "title"}, {"field": "state"}, {"field": "fixed_by"}, {"field": "origin"}], "group": "state", "sort": {"field": "number"}}]
    },
    {
      "name": "Discussions",
      "collection": "discussions",
      "overview": {"kind": "bars", "field": "run", "value": "posts", "agg": "sum"},
      "zoom": "a click on a run keeps its discussions",
      "filter": {"fields": ["run"]},
      "body": [{"kind": "list", "meta": ["run", "author", "posts"]}]
    },
    {
      "name": "Agents",
      "collection": "agents",
      "overview": {"kind": "bars", "field": "run", "value": "opened", "agg": "sum"},
      "zoom": "a click on a run keeps its agents",
      "filter": {"fields": ["run"]},
      "body": [{"kind": "table", "columns": [{"field": "name"}, {"field": "run"}, {"field": "opened"}, {"field": "merged", "show": "bar"}, {"field": "approved"}, {"field": "changes"}, {"field": "comments"}]}]
    }
  ],
  "accepts": [{"form": "L<n>", "means": "the record on line <n> of a run's file, selected in its pull request, issue or discussion"}],
  "units": [{"form": "<run>/pull/<n>", "means": "one pull request with its story"}, {"form": "<run>/issues/<n>", "means": "one issue with its story"}]
}
